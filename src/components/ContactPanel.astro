---
import siteConfig from '../data/site-config';
import Button from './Button.astro';
import Icon from './Icon.astro';

const primaryEmail = 'contact@dankehidayat.my.id';
const alternateEmail = 'dnk.hidayat@gmail.com';
const resumeHref = '/Resume_Danke_Hidayat.pdf';

const socials = (siteConfig.socialLinks ?? []).filter((l) => !l.href.includes('rss'));
const iconFor = (href: string) =>
    href.includes('github') ? 'github' : href.includes('linkedin') ? 'linkedin' : 'bluesky';
---

<section class="contact" id="contact" aria-label="Contact">
    <div class="site-shell">
        <div class="contact-inner">
            <div class="contact-primary" data-reveal>
                <header class="contact-head">
                    <span class="section-tick" aria-hidden="true" />
                    <h2 class="section-title">Contact</h2>
                </header>
                <a class="contact-email" href={`mailto:${primaryEmail}`}>{primaryEmail}</a>
                <p class="contact-lede">
                    Open to opportunities in software development, DevOps, and IoT. I usually reply within a few days.
                </p>
                <div class="contact-actions">
                    <Button href={`mailto:${primaryEmail}`} variant="dark">Write me</Button>
                    <Button href={resumeHref} variant="dark-ghost" download>Resume</Button>
                </div>
                <p class="contact-alt">
                    Alternative address: <a href={`mailto:${alternateEmail}`}>{alternateEmail}</a>
                </p>
            </div>

            <div class="contact-side" data-reveal>
                <p class="contact-side-title">Elsewhere</p>
                <ul class="contact-social-list">
                    {
                        socials.map((link) => (
                            <li>
                                <a href={link.href} target="_blank" rel="noopener noreferrer">
                                    <span class="social-icon">
                                        <Icon name={iconFor(link.href)} aria-hidden="true" />
                                        {link.text}
                                    </span>
                                    <Icon name="arrow-right" class="social-arrow" aria-hidden="true" />
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>
