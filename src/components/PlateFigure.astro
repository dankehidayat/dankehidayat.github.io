---
/**
 * PlateFigure — one specimen plate of the folio.
 * Arch frame + engraved plate image (data-image-slot="plate-<id>") +
 * italic name + small-caps stage label + plate number. Images are passed
 * in as static imports from src/data/folio-plates.ts; the hatch + floret
 * remains only as a defensive no-image fallback (never rendered in the
 * built site — every call site supplies an image).
 *
 * The plate ships as a width-laddered `srcset` (see lib/responsive-image),
 * never the full-resolution master: a 1661×2154 Köhler engraving used to
 * travel whole for a ~300px arch.
 */
import { PLATE_SIZES, PLATE_WIDTHS, responsiveImage } from '../lib/responsive-image';
import type { FolioPlateImage } from '../data/folio-plates';

type Props = {
    /** Plate number, e.g. "01" (title plate uses "001") */
    number: string;
    /** Italic plate name (work title or species name) */
    name: string;
    /** Small-caps stage/descriptor line under the name */
    label: string;
    /** Work id — becomes data-image-slot="plate-<id>" */
    id: string;
    /** When set, the whole plate becomes a link */
    href?: string | undefined;
    variant?: 'featured' | 'cell' | 'mini' | 'detail';
    /** Optional one-line description (works index cells) */
    description?: string | undefined;
    /** Optional CTA line under the cell (works index) */
    cta?: string | undefined;
    /** Static-imported plate image with factual alt text */
    image?: FolioPlateImage | undefined;
    /**
     * Overrides the `sizes` hint when the plate sits in a grid the variant
     * does not describe (the six-across home strip, for one).
     */
    sizes?: string | undefined;
};

const { number, name, label, id, href, variant = 'cell', description, cta, image } =
    Astro.props;
const Tag = href ? 'a' : 'div';
const eager = variant === 'featured';
const plate = image
    ? await responsiveImage(image.src, { widths: PLATE_WIDTHS, quality: 80 })
    : null;
const sizes = Astro.props.sizes ?? PLATE_SIZES[variant] ?? PLATE_SIZES.cell;
---

<Tag
    class:list={['plate', `plate--${variant}`]}
    {...(href ? { href } : {})}
    data-plate
>
    <div class="plate-frame">
        {/* Shared-element pairing (Leafing): the framed picture morphs
            between grid cell, hero record, and adjacent plate across
            soft navigations — labels crossfade with the page instead. */}
        <div class="plate-arch" style={`view-transition-name: plate-${id}`}>
            <div class="plate-slot" data-image-slot={`plate-${id}`}>
                {
                    plate && image ? (
                        <img
                            src={plate.src}
                            srcset={plate.srcset}
                            sizes={sizes}
                            width={plate.width}
                            height={plate.height}
                            alt={image.alt}
                            loading={eager ? 'eager' : 'lazy'}
                            decoding="async"
                            fetchpriority={eager ? 'high' : 'auto'}
                        />
                    ) : (
                        <svg class="floret" viewBox="0 0 24 24" aria-hidden="true">
                            <g
                                stroke="currentColor"
                                stroke-width="1.3"
                                stroke-linecap="round"
                                fill="none"
                            >
                                <path d="M12 2.5v19M3.77 7.25l16.46 9.5M3.77 16.75l16.46-9.5" />
                            </g>
                            <circle cx="12" cy="12" r="1.7" fill="currentColor" />
                        </svg>
                    )
                }
            </div>
        </div>
    </div>
    <div class="plate-labels">
        <span class="plate-baseline" aria-hidden="true"></span>
        <span class="plate-name">{name}</span>
        <span class="plate-label">{label}</span>
        <span class="plate-num">{number}</span>
        <svg class="floret" viewBox="0 0 24 24" aria-hidden="true">
            <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none">
                <path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"></path>
            </g>
            <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
        </svg>
        {description && <span class="plate-desc">{description}</span>}
        {cta && <span class="plate-cta">{cta}</span>}
    </div>
</Tag>
