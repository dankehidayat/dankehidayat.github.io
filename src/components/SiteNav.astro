---
/**
 * SiteNav — the folio's running head (owner amendments 2026-09-24:
 * order = About · Folio | Danke (brand, center) · Florilegium · Atelier;
 * brand reads "Danke"; theme toggle icon-only; previous floating pill
 * rejected). Owner 2026-09-26 — "remove the list of the works project,
 * it should be just works only": the work plates are a plain link, the
 * project-list dropdown is gone from the strip and from the sheet;
 * renamed Works → Folio the same day (nav vocabulary + route /folio).
 *
 * Mobile (2026-09-25 redesign, owner: "improve the mobile navbar layout"):
 * the disclosure panel is a full-screen contents sheet — Bodoni index
 * entries on hairline rules and a footer holding the theme toggle +
 * Resume/Contact tickets. The strip keeps brand + the menu glyph
 * (two rules → X); below 900px the theme toggle moves into the sheet
 * footer.
 */
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const anchor = (hash: string) => (!isHome && hash.startsWith('#')) ? `/${hash}` : hash;
const activeId = isHome ? pathname.split('#')[0] : null;
const resumeHref = '/Resume_Danke_Hidayat.pdf';
---

<header class="site-nav">
    <div class="site-nav-inner">
        <nav class="site-nav-group site-nav-group--start" aria-label="Primary">
            <a
                href={anchor('#about')}
                class:list={['site-link', isHome && activeId === 'about' && 'is-active']}
            >
                About
            </a>

            {/* Folio is a plain link (owner 2026-09-26, renamed from Works
                2026-09-26): the project-list dropdown is retired — /folio/
                carries its own contents. */}
            <a
                href="/folio"
                class:list={['site-link', pathname.startsWith('/folio') && 'is-active']}
            >
                Folio
            </a>
        </nav>

        <a href="/" class="site-logo" aria-label="Danke — home">
            <span class="site-logo-name">Danke</span>
            <svg class="site-logo-floret" viewBox="0 0 24 24" aria-hidden="true">
                <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none">
                    <path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"></path>
                </g>
                <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
            </svg>
        </a>

        <nav class="site-nav-group site-nav-group--end" aria-label="More">
            <a
                href="/florilegium"
                class:list={[
                    'site-link',
                    (pathname === '/florilegium' || pathname.startsWith('/florilegium')) &&
                        'is-active'
                ]}
            >
                Florilegium
            </a>
            <a
                href="/atelier"
                class:list={['site-link', pathname === '/atelier' && 'is-active']}
            >
                Atelier
            </a>
            <ThemeToggle />
            <button
                type="button"
                class="site-menu-btn"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="site-mobile"
            >
                {/* Two rules that cross into an X when open — the resting
                    pair echoes the strip's double hairline (owner 2026-09-26). */}
                <span class="menu-bars" aria-hidden="true">
                    <span class="menu-bar"></span>
                    <span class="menu-bar"></span>
                </span>
            </button>
        </nav>
    </div>

    {/* Mobile contents sheet — index entries on hairline rules; the strip
        above stays put (brand + two-rule glyph → X), this fills the
        viewport below the running head's double rule. */}
    <div id="site-mobile" class="site-mobile">
        <div class="site-mobile-inner">
            <p class="site-mobile-label site-mobile-anim" style="--i: 0">Contents</p>

            <ul class="site-mobile-index">
                <li class="site-mobile-anim" style="--i: 1">
                    <a
                        href={anchor('#about')}
                        class:list={[
                            'site-mobile-entry',
                            isHome && activeId === 'about' && 'is-active'
                        ]}
                    >
                        About
                        <Icon name="arrow-right" />
                    </a>
                </li>
                <li class="site-mobile-anim" style="--i: 2">
                    <a
                        href="/folio"
                        class:list={[
                            'site-mobile-entry',
                            pathname.startsWith('/folio') && 'is-active'
                        ]}
                    >
                        Folio
                        <Icon name="arrow-right" />
                    </a>
                </li>
                <li class="site-mobile-anim" style="--i: 3">
                    <a
                        href="/florilegium"
                        class:list={[
                            'site-mobile-entry',
                            (pathname === '/florilegium' ||
                                pathname.startsWith('/florilegium')) &&
                                'is-active'
                        ]}
                    >
                        Florilegium
                        <Icon name="arrow-right" />
                    </a>
                </li>
                <li class="site-mobile-anim" style="--i: 4">
                    <a
                        href="/atelier"
                        class:list={['site-mobile-entry', pathname === '/atelier' && 'is-active']}
                    >
                        Atelier
                        <Icon name="arrow-right" />
                    </a>
                </li>
            </ul>

            <div class="site-mobile-foot site-mobile-anim" style="--i: 5">
                <div class="site-mobile-foot-row">
                    <span class="site-mobile-label">Theme</span>
                    <ThemeToggle />
                </div>
                <div class="site-mobile-foot-actions">
                    <a class="btn btn-resume" href={resumeHref} download>Resume</a>
                    <a class="btn btn-primary" href={anchor('#contact')}>
                        Contact
                        <Icon name="arrow-right" aria-hidden="true" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
    /* One document-scoped set of listeners, bound once: soft navigations
       re-run bind() (fresh elements) but never stack duplicate handlers. */
    const DESKTOP = '(min-width: 900px)';
    const FOCUSABLE =
        'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

    let btn: HTMLButtonElement | null = null;
    let menu: HTMLElement | null = null;
    let head: HTMLElement | null = null;
    let docBound = false;

    const isOpen = () => Boolean(menu?.classList.contains('is-open'));

    const sheetFocusables = (): HTMLElement[] =>
        menu
            ? Array.from(menu.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
                  (el) => el.getClientRects().length > 0
              )
            : [];

    function measure() {
        // offsetHeight = strip + its 1px border; the sheet starts there and
        // runs to the viewport bottom, so the sheet lands flush.
        if (head) head.style.setProperty('--site-nav-h', `${head.offsetHeight}px`);
    }

    function setOpen(open: boolean) {
        if (!btn || !menu) return;
        if (open) measure();
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menu.classList.toggle('is-open', open);
        // Scroll lock lives on <body>: locking <html> hands it the strip's
        // scrollport and drops the sticky head (and the sheet) off-screen.
        document.body.classList.toggle('is-nav-lock', open);
        if (open) sheetFocusables()[0]?.focus({ preventScroll: true });
    }

    function close(returnFocus: boolean) {
        if (!btn || !menu || !isOpen()) return;
        const hadFocus =
            menu.contains(document.activeElement) || document.activeElement === btn;
        setOpen(false);
        if (returnFocus && hadFocus) btn.focus({ preventScroll: true });
    }

    function bind() {
        btn = document.querySelector<HTMLButtonElement>('.site-menu-btn');
        menu = document.querySelector<HTMLElement>('#site-mobile');
        head = document.querySelector<HTMLElement>('.site-nav');
        if (!btn || !menu) return;

        btn.onclick = () => (isOpen() ? close(true) : setOpen(true));

        // Capture phase: release the scroll lock before any anchor handler
        // (motion.ts smooth-scrolls #links) reads the page — a locked
        // viewport would swallow that scroll.
        if (!docBound) {
            docBound = true;

            document.addEventListener(
                'click',
                (e) => {
                    if (!isOpen()) return;
                    const link = (e.target as Element | null)?.closest?.('a');
                    if (link && menu?.contains(link)) close(true);
                },
                true
            );

            document.addEventListener('click', (e) => {
                const target = e.target as Node | null;
                if (isOpen() && target && !menu?.contains(target) && !btn?.contains(target)) {
                    close(false);
                }
            });

            document.addEventListener('keydown', (e) => {
                if (!isOpen()) return;
                if (e.key === 'Escape') {
                    close(true);
                    return;
                }
                if (e.key !== 'Tab') return;

                // Focus ring stays on the strip button + the sheet.
                const items = [btn as HTMLElement, ...sheetFocusables()];
                const first = items[0];
                const last = items[items.length - 1];
                const active = document.activeElement;
                if (!first || !last || first === last) return;
                if (!items.includes(active as HTMLElement)) {
                    e.preventDefault();
                    first.focus();
                } else if (e.shiftKey && active === first) {
                    e.preventDefault();
                    last.focus();
                } else if (!e.shiftKey && active === last) {
                    e.preventDefault();
                    first.focus();
                }
            });

            const desktop = window.matchMedia(DESKTOP);
            const sync = () => {
                if (!isOpen()) return;
                if (desktop.matches) close(false);
                else measure();
            };
            desktop.addEventListener('change', sync);
            window.addEventListener('resize', sync);

            // Lenis smooth-scroll listens in the bubble phase; while the
            // sheet is open, swallow wheel/touch so it never accumulates a
            // scroll target behind the lock (the page jump would land on
            // close). stopPropagation — not preventDefault — so the sheet
            // keeps its own native scrolling.
            const swallow = (e: Event) => {
                if (isOpen()) e.stopPropagation();
            };
            window.addEventListener('wheel', swallow, { capture: true, passive: true });
            window.addEventListener('touchmove', swallow, { capture: true, passive: true });
        }

        // ── Active section observer (home anchors; strip + sheet entries) ──
        const links = Array.from(
            document.querySelectorAll<HTMLAnchorElement>('.site-link, .site-mobile-entry')
        );
        const sections = links
            .map((link) => link.hash && document.getElementById(link.hash.slice(1)))
            .filter((el): el is HTMLElement => Boolean(el));
        if (!sections.length) return;

        const setActive = (id: string | null) => {
            links.forEach((link) => {
                const isMatch = id !== null && link.hash === `#${id}`;
                link.classList.toggle('is-active', isMatch);
            });
        };

        const observer = new IntersectionObserver(
            (entries) => {
                const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio);
                if (visible[0]) setActive(visible[0].target.id);
            },
            { rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.25, 0.5, 1] }
        );
        sections.forEach((s) => observer.observe(s));
    }
    bind();
    document.addEventListener('astro:page-load', bind);
</script>
