---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { sortItemsByDateDesc } from '../utils/data-utils';

const blogPosts = (await getCollection('blog')).sort(sortItemsByDateDesc).slice(0, 5);

const links = [
    { text: 'About', href: '#about' },
    { text: 'Experience', href: '#experience' },
    { text: 'Stack', href: '#stack' },
    { text: 'Projects', href: '#projects' },
    { text: 'Notes', href: '/notes', dropdown: true },
    { text: 'Fun', href: '/fun' }
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const anchor = (hash: string) => (!isHome && hash.startsWith('#')) ? `/${hash}` : hash;
const activeId = isHome ? pathname.split('#')[0] : null;
---

<header class="site-nav">
    <div class="site-nav-pill">
        <div class="site-nav-inner">
            <a href="/" class="site-logo">
                Danke Hidayat
            </a>

            <nav class="site-links" aria-label="Primary">
                {
                    links.map((link) => (
                        link.dropdown ? (
                            <div class="site-dropdown">
                                <a
                                    href={anchor(link.href)}
                                    class:list={['site-link', isHome && activeId === link.href.slice(1) && 'is-active']}
                                    aria-haspopup="true"
                                    aria-expanded="false"
                                >
                                    {link.text}
                                </a>
                                <div class="site-dropdown-panel" role="menu">
                                    <p class="site-dropdown-heading">Recent Notes</p>
                                    {blogPosts.map((post) => (
                                        <a
                                            href={`/notes/${post.id}/`}
                                            class="site-dropdown-item"
                                            role="menuitem"
                                            tabindex="-1"
                                        >
                                            <span class="site-dropdown-item-name">{post.data.title}</span>
                                        </a>
                                    ))}
                                </div>
                            </div>
                        ) : (
                            <a
                                href={anchor(link.href)}
                                class:list={['site-link', isHome && activeId === link.href.slice(1) && 'is-active']}
                            >
                                {link.text}
                            </a>
                        )
                    ))
                }
            </nav>

            <div class="site-nav-end">
                <a href={anchor('#contact')} class="btn btn-tangerine site-nav-cta">
                    Contact
                    <Icon name="arrow-right" aria-hidden="true" />
                </a>
                <button
                    type="button"
                    class="site-menu-btn"
                    aria-label="Open menu"
                    aria-expanded="false"
                    aria-controls="site-mobile"
                >
                    <span class="menu-bars" aria-hidden="true">
                        <span class="menu-bar"></span>
                        <span class="menu-bar"></span>
                        <span class="menu-bar"></span>
                    </span>
                </button>
            </div>
        </div>

        <div id="site-mobile" class="site-mobile">
            {
                links.map((link) => (
                    <a href={anchor(link.href)} class="site-mobile-link">
                        {link.text}
                        <Icon name="arrow-right" />
                    </a>
                ))
            }
            <a href={anchor('#contact')} class="btn btn-tangerine">
                Contact
                <Icon name="arrow-right" aria-hidden="true" />
            </a>
        </div>
    </div>
</header>

<script>
    function bind() {
        const btn = document.querySelector<HTMLButtonElement>('.site-menu-btn');
        const menu = document.querySelector<HTMLElement>('#site-mobile');
        if (!btn || !menu) return;

        const setOpen = (open: boolean) => {
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
            menu.classList.toggle('is-open', open);
        };

        const close = () => setOpen(false);

        btn.onclick = () => {
            const open = btn.getAttribute('aria-expanded') !== 'true';
            setOpen(open);
            if (open) {
                menu.querySelector<HTMLAnchorElement>('a')?.focus();
            }
        };

        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && menu.classList.contains('is-open')) {
                close();
                btn.focus();
            }
        });
        document.addEventListener('click', (e) => {
            if (
                menu.classList.contains('is-open') &&
                !menu.contains(e.target as Node) &&
                !btn.contains(e.target as Node)
            ) {
                close();
            }
        });

        // ── Desktop dropdown hover/focus ──
        const dropdowns = document.querySelectorAll<HTMLElement>('.site-dropdown');
        dropdowns.forEach((dd) => {
            let timer: ReturnType<typeof setTimeout> | null = null;
            const toggle = (open: boolean) => {
                dd.classList.toggle('is-open', open);
                const link = dd.querySelector<HTMLAnchorElement>('.site-link');
                if (link) link.setAttribute('aria-expanded', open ? 'true' : 'false');
            };
            dd.addEventListener('mouseenter', () => {
                if (timer) { clearTimeout(timer); timer = null; }
                toggle(true);
            });
            dd.addEventListener('mouseleave', () => {
                timer = setTimeout(() => toggle(false), 120);
            });
            const link = dd.querySelector<HTMLAnchorElement>('.site-link');
            const panel = dd.querySelector<HTMLElement>('.site-dropdown-panel');
            if (link && panel) {
                link.addEventListener('focus', () => toggle(true));
                link.addEventListener('blur', (e) => {
                    // Keep open if focus moved inside the panel
                    if (panel.contains(e.relatedTarget as Node)) return;
                    toggle(false);
                });
                panel.addEventListener('focusin', () => toggle(true));
                panel.addEventListener('focusout', (e) => {
                    if (dd.contains(e.relatedTarget as Node)) return;
                    toggle(false);
                });
                // Keyboard navigation inside panel
                const items = panel.querySelectorAll<HTMLAnchorElement>('.site-dropdown-item');
                panel.addEventListener('keydown', (e) => {
                    const current = document.activeElement as HTMLElement;
                    const idx = Array.from(items).indexOf(current as HTMLAnchorElement);
                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        const next = items[(idx + 1) % items.length];
                        next.focus();
                    } else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        const prev = items[(idx - 1 + items.length) % items.length];
                        prev.focus();
                    } else if (e.key === 'Escape') {
                        toggle(false);
                        link.focus();
                    }
                });
            }
        });

        // ── Active section observer ──
        const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.site-link'));
        const sections = links
            .map((link) => link.hash && document.getElementById(link.hash.slice(1)))
            .filter((el): el is HTMLElement => Boolean(el));
        if (!sections.length) return;

        const setActive = (id: string | null) => {
            links.forEach((link) => {
                const isMatch = id !== null && link.hash === `#${id}`;
                link.classList.toggle('is-active', isMatch);
            });
        };

        const observer = new IntersectionObserver(
            (entries) => {
                const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio);
                if (visible[0]) setActive(visible[0].target.id);
            },
            { rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.25, 0.5, 1] }
        );
        sections.forEach((s) => observer.observe(s));
    }
    bind();
    document.addEventListener('astro:page-load', bind);
</script>
