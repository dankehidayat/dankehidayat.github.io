---
type Props = { date: Date; lang?: string };
const { date, lang = 'en' } = Astro.props;
---

<time datetime={date.toISOString()}>
    {
        date.toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
        })
    }
</time>
