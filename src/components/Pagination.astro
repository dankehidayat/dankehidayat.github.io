---
import type { Page } from 'astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

type Props = { page: Page<unknown>; lang: Lang; class?: string };
const { page, lang, class: className } = Astro.props;
const t = useTranslations(lang);
---

{
    (page.url.prev || page.url.next) && (
        <nav class:list={['pagination', className]} aria-label="Pagination">
            {page.url.prev ? (
                <a href={page.url.prev} class="btn btn-secondary">
                    ← {t('pagination.prev')}
                </a>
            ) : (
                <span />
            )}
            <span class="page-num">
                {page.currentPage} / {page.lastPage}
            </span>
            {page.url.next ? (
                <a href={page.url.next} class="btn btn-secondary">
                    {t('pagination.next')} →
                </a>
            ) : (
                <span />
            )}
        </nav>
    )
}

<style is:global>
    .pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }
    .page-num {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--slate-muted);
        font-variant-numeric: tabular-nums;
    }
</style>
