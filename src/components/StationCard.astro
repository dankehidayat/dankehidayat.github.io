---
import type { CollectionEntry } from 'astro:content';
import { projectBlurb } from '../data/project-i18n';
import type { Lang } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';

type Props = {
    project: CollectionEntry<'projects'>;
    lang: Lang;
    index?: number;
    class?: string;
    headingLevel?: 'h2' | 'h3';
};

const { project, lang, index = 0, class: className, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const Tag = headingLevel;
const href = localePath(lang, `/projects/${project.id}`);
const n = String(index + 1).padStart(2, '0');
const description = projectBlurb(
    project.id,
    lang,
    project.data.description,
    project.data.descriptionId
);
---

<a href={href} class:list={['work-card', className]}>
    <p class="label-kicker">{t('work.signal')} {n}</p>
    <Tag>{project.data.title}</Tag>
    {description && <p>{description}</p>}
    <span class="work-card-arrow">{t('work.open')} →</span>
</a>
