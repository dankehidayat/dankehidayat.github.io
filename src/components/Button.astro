---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'inverse' | 'inverse-ghost' | 'dark' | 'dark-ghost';
type AnchorProps = HTMLAttributes<'a'> & { href: string; type?: never; variant?: Variant };
type ButtonProps = HTMLAttributes<'button'> & { href?: never; variant?: Variant };
type Props = ButtonProps | AnchorProps;

const { href, class: className, variant = 'secondary', ...rest } = Astro.props;
const classes = ['btn', `btn-${variant}`, className].filter(Boolean).join(' ');
---

{
    href ? (
        <a href={href} class={classes} {...rest}>
            <slot />
        </a>
    ) : (
        <button class:list={[classes, 'cursor-pointer']} {...rest}>
            <slot />
        </button>
    )
}
