---
/**
 * MarqueeBand — a hairline-ruled running band of folio text.
 * Pure CSS keyframes (paused under prefers-reduced-motion in folio.css);
 * decorative, so it stays out of the accessibility tree.
 */
type Item = { text: string; italic?: boolean };

type Props = {
    items: Item[];
};

const { items } = Astro.props;
---

<div class="marquee" aria-hidden="true">
    <div class="marquee-track">
        {
            [0, 1].map(() => (
                <div class="marquee-group">
                    {items.map((item) => (
                        <span class="marquee-item">
                            {item.italic ? <em>{item.text}</em> : item.text}
                            <svg class="floret" viewBox="0 0 24 24">
                                <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none">
                                    <path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9" />
                                </g>
                                <circle cx="12" cy="12" r="1.5" fill="currentColor" />
                            </svg>
                        </span>
                    ))}
                </div>
            ))
        }
    </div>
</div>
