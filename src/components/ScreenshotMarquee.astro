---
/**
 * ScreenshotMarquee — an infinite horizontal band of project screenshots
 * (real images from public/projects/, captured 2026-09 — owner evidence,
 * never fabricated). Slots without a src fall back to the honest pending
 * hatch. Decorative duplicate of the plate grid, so it stays out of the
 * accessibility tree; reuses .marquee-track so GSAP velocity and the
 * prefers-reduced-motion pause apply automatically.
 */
type Shot = {
    number: string;
    name: string;
    src?: string | undefined;
    width?: number | undefined;
    height?: number | undefined;
};

type Props = {
    shots: Shot[];
};

const { shots } = Astro.props;
---

<div class="marquee marquee--shots" aria-hidden="true">
    <div class="marquee-track">
        {
            [0, 1].map(() => (
                <div class="marquee-group shot-group">
                    {shots.map((shot) => (
                        <div class="shot-slot">
                            <div
                                class:list={['shot-frame', shot.src && 'shot-frame--image']}
                                data-image-slot={`shot-${shot.number}`}
                            >
                                {shot.src ? (
                                    <img
                                        src={shot.src}
                                        alt=""
                                        width={shot.width ?? 1440}
                                        height={shot.height ?? 900}
                                        loading="lazy"
                                        decoding="async"
                                    />
                                ) : (
                                    <>
                                        <svg class="floret" viewBox="0 0 24 24">
                                            <g
                                                stroke="currentColor"
                                                stroke-width="1.3"
                                                stroke-linecap="round"
                                                fill="none"
                                            >
                                                <path d="M12 2.5v19M3.77 7.25l16.46 9.5M3.77 16.75l16.46-9.5" />
                                            </g>
                                            <circle cx="12" cy="12" r="1.7" fill="currentColor" />
                                        </svg>
                                        <span class="shot-pending">Screenshot · pending</span>
                                    </>
                                )}
                            </div>
                            <div class="shot-cap">
                                <span class="shot-num">{shot.number}</span>
                                <span class="shot-name">{shot.name}</span>
                            </div>
                        </div>
                    ))}
                </div>
            ))
        }
    </div>
</div>
