---
/**
 * ScreenshotMarquee — an infinite horizontal band of project screenshots
 * (real images from src/assets/images/projects/, captured 2026-09 — owner
 * evidence, never fabricated). Slots without a src fall back to the honest
 * pending hatch. Decorative duplicate of the plate grid, so it stays out of
 * the accessibility tree; reuses .marquee-track so GSAP velocity and the
 * prefers-reduced-motion pause apply automatically.
 *
 * Each shot is a width laddered `srcset` capped at the slot's own width
 * (clamp(19rem, 27vw, 27rem)) — the masters are 3360px dashboard captures
 * and used to travel whole into this aria-hidden band.
 */
import { SHOT_SIZES, SHOT_WIDTHS, responsiveImage } from '../lib/responsive-image';

type Shot = {
    number: string;
    name: string;
    src?: ImageMetadata | undefined;
};

type Props = {
    shots: Shot[];
};

const { shots } = Astro.props;

const slots = await Promise.all(
    shots.map(async (shot) => ({
        number: shot.number,
        name: shot.name,
        image: shot.src ? await responsiveImage(shot.src, { widths: SHOT_WIDTHS, quality: 74 }) : null
    }))
);
---

<div class="marquee marquee--shots" aria-hidden="true">
    <div class="marquee-track">
        {
            [0, 1].map(() => (
                <div class="marquee-group shot-group">
                    {slots.map((shot) => (
                        <div class="shot-slot">
                            <div
                                class:list={['shot-frame', shot.image && 'shot-frame--image']}
                                data-image-slot={`shot-${shot.number}`}
                            >
                                {shot.image ? (
                                    <img
                                        src={shot.image.src}
                                        srcset={shot.image.srcset}
                                        sizes={SHOT_SIZES}
                                        alt=""
                                        width={shot.image.width}
                                        height={shot.image.height}
                                        loading="lazy"
                                        decoding="async"
                                    />
                                ) : (
                                    <>
                                        <svg class="floret" viewBox="0 0 24 24">
                                            <g
                                                stroke="currentColor"
                                                stroke-width="1.3"
                                                stroke-linecap="round"
                                                fill="none"
                                            >
                                                <path d="M12 2.5v19M3.77 7.25l16.46 9.5M3.77 16.75l16.46-9.5" />
                                            </g>
                                            <circle cx="12" cy="12" r="1.7" fill="currentColor" />
                                        </svg>
                                        <span class="shot-pending">Screenshot · pending</span>
                                    </>
                                )}
                            </div>
                            <div class="shot-cap">
                                <span class="shot-num">{shot.number}</span>
                                <span class="shot-name">{shot.name}</span>
                            </div>
                        </div>
                    ))}
                </div>
            ))
        }
    </div>
</div>
