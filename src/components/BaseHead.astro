---
import bodoniWoff2 from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-wght-normal.woff2?url';
import bodoniItalicWoff2 from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-wght-italic.woff2?url';
import newsreaderWoff2 from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import siteConfig from '../data/site-config';
import type { ImageInput } from '../types';

import '../styles/global.css';
import '../styles/folio.css';

export type Props = {
    title?: string;
    description?: string;
    image?: ImageInput | undefined;
    pageType?: 'website' | 'article';
};

const { description = '', pageType = 'website' } = Astro.props;
const pageTitle = Astro.props.title;
const title = !pageTitle || pageTitle === siteConfig.title ? siteConfig.title : `${pageTitle} · ${siteConfig.title}`;
const image = Astro.props.image ?? siteConfig.image;
let resolvedImage: { src: string; alt?: string } | undefined;
if (image?.src) {
    if (typeof image.src === 'string') {
        resolvedImage = { src: new URL(image.src, Astro.site).toString(), alt: image.alt };
    } else {
        const optimizedImage = await getImage({
            src: image.src as ImageMetadata,
            width: 1200,
            height: 630,
            format: 'jpeg',
            fit: 'cover'
        });
        resolvedImage = {
            src: new URL(optimizedImage.src, Astro.site).toString(),
            alt: image.alt
        };
    }
}
const canonicalURL = new URL(Astro.request.url, Astro.site);

function formatCanonicalURL(url: string | URL) {
    const path = url.toString();
    const hasQueryParams = path.includes('?');
    return path.replace(/\/?$/, hasQueryParams ? '' : '/');
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="generator" content={Astro.generator} />

<link rel="preload" as="font" type="font/woff2" href={bodoniWoff2} crossorigin="anonymous" />
<link rel="preload" as="font" type="font/woff2" href={bodoniItalicWoff2} crossorigin="anonymous" />
<link rel="preload" as="font" type="font/woff2" href={newsreaderWoff2} crossorigin="anonymous" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<link rel="canonical" href={formatCanonicalURL(canonicalURL)} />
<meta name="description" content={description} />
<meta name="theme-color" content="#F6F1E6" />
<meta name="color-scheme" content="light dark" />

<!--
  Theme resolve, pre-paint: stored choice first, else the system preference.
  Sets data-theme on <html> before body renders (no flash) and keeps the
  browser chrome in step. folio-theme is written by ThemeToggle.astro.
-->
<script is:inline>
    (function () {
        /* Resolve the theme: an explicit stored choice wins, else the system
           preference. Kept idempotent so it can be re-run after a swap. */
        function resolveTheme() {
            try {
                var stored = localStorage.getItem('folio-theme');
                if (stored === 'light' || stored === 'dark') return stored;
            } catch (e) {
                /* private mode etc. */
            }
            return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function applyTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', theme === 'dark' ? '#17150F' : '#F6F1E6');
        }

        try {
            applyTheme(resolveTheme());
        } catch (e) {
            /* CSS media fallback covers it */
        }

        /* ClientRouter swaps the incoming document's <html> attributes onto the
           live element, and the static markup has no data-theme — so a soft
           navigation stripped it and the page fell back to light. Re-apply on
           the incoming document before the swap, and on the live one after, so
           the theme survives every client-side navigation without a flash. */
        document.addEventListener('astro:before-swap', function (e) {
            try {
                if (e.newDocument) {
                    e.newDocument.documentElement.setAttribute('data-theme', resolveTheme());
                }
            } catch (err) {
                /* no-op */
            }
        });
        document.addEventListener('astro:after-swap', function () {
            try {
                applyTheme(resolveTheme());
            } catch (err) {
                /* no-op */
            }
        });
    })();
</script>

<meta property="og:type" content={pageType} />
<meta property="og:url" content={formatCanonicalURL(canonicalURL)} />
<meta property="og:title" content={title} />
<meta property="og:locale" content="en_US" />
{description && <meta property="og:description" content={description} />}
{resolvedImage?.src && <meta property="og:image" content={resolvedImage.src} />}
{resolvedImage?.alt && <meta property="og:image:alt" content={resolvedImage.alt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={formatCanonicalURL(canonicalURL)} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{resolvedImage?.src && <meta name="twitter:image" content={resolvedImage.src} />}
