---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

type Props = {
    post: CollectionEntry<'blog'>;
    class?: string;
    headingLevel?: 'h2' | 'h3';
    showExcerpt?: boolean;
};

const { post, class: className, headingLevel = 'h3', showExcerpt = true } = Astro.props;
const Tag = headingLevel;
const href = `/blog/${post.id}/`;
---

<article class:list={['post-row', className]} data-row>
    <a href={href} class="post-row-link">
        <div class="post-row-meta">
            <FormattedDate date={post.data.publishDate} />
        </div>
        <Tag class="post-row-title">{post.data.title}</Tag>
        {showExcerpt && post.data.excerpt && <p class="post-row-excerpt">{post.data.excerpt}</p>}
    </a>
</article>
