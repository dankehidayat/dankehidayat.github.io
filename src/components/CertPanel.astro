---
import { certificationsByDate, type Certification } from '../data/certifications';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

type Props = {
    lang: Lang;
    /** Cap home preview; omit to show all */
    limit?: number;
};

const { lang, limit } = Astro.props;
const t = useTranslations(lang);
const items: Certification[] = limit
    ? certificationsByDate.slice(0, limit)
    : certificationsByDate;

const sourceLabel = (source: Certification['source']) => {
    switch (source) {
        case 'coursera':
            return 'Coursera';
        case 'credly':
            return 'Credly';
        case 'cisco':
            return 'Cisco';
        default:
            return t('certs.verify');
    }
};
---

<div class="cert-wall">
    {
        items.map((cert, i) => {
            const n = String(i + 1).padStart(2, '0');
            const Tag = cert.url ? 'a' : 'div';
            const linkProps = cert.url
                ? {
                      href: cert.url,
                      target: '_blank',
                      rel: 'noopener noreferrer'
                  }
                : {};

            return (
                <Tag
                    class:list={['cert-card', !cert.url && 'cert-card-static']}
                    data-reveal
                    {...linkProps}
                >
                    <div class="cert-row-top">
                        <p class="label-kicker">
                            {t('certs.signal')} {n}
                        </p>
                        <span class="cert-issued">{cert.issued}</span>
                    </div>
                    <h3 class="cert-title">{cert.title}</h3>
                    <p class="cert-issuer">{cert.issuer}</p>
                    {cert.credentialId && (
                        <p class="cert-id">
                            <span>{t('certs.id')}</span> {cert.credentialId}
                        </p>
                    )}
                    {cert.url ? (
                        <span class="cert-link">
                            {t('certs.verify')} · {sourceLabel(cert.source)} →
                        </span>
                    ) : (
                        <span class="cert-link cert-link-muted">{t('certs.noLink')}</span>
                    )}
                </Tag>
            );
        })
    }
</div>
