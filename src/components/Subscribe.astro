---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

type Props = { lang?: Lang };
const lang = Astro.props.lang ?? 'en';
const t = useTranslations(lang);
---

<aside class="subscribe-band" data-reveal>
    <p class="label-kicker">{t('subscribe.title')}</p>
    <p class="subscribe-text">{t('subscribe.text')}</p>
    <a class="btn btn-secondary" href="/rss.xml">{t('subscribe.cta')}</a>
</aside>

<style is:global>
    .subscribe-band {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.85rem;
        margin-top: 2.5rem;
        padding: 1.5rem 1.5rem;
        border-radius: var(--radius-lg);
        background: var(--surface);
        border: 1px solid var(--line);
    }
    .subscribe-text {
        margin: 0;
        color: var(--ink-soft);
        max-width: 30rem;
        line-height: 1.55;
    }
</style>
