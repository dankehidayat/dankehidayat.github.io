---
import { Image } from 'astro:assets';
import type { ImageInput } from '../types';

type Props = ImageInput & {
    class?: string;
    widths?: number[];
    sizes?: string;
    loading?: 'eager' | 'lazy';
    fetchpriority?: 'high' | 'low' | 'auto';
};

const { src, alt = '', class: className, widths, sizes, loading = 'lazy', fetchpriority, caption } = Astro.props;
---

{
    typeof src === 'string' ? (
        <img src={src} alt={alt} class={className} loading={loading} fetchpriority={fetchpriority} />
    ) : (
        <Image
            src={src}
            alt={alt}
            class={className}
            widths={widths}
            sizes={sizes}
            loading={loading}
            fetchpriority={fetchpriority}
        />
    )
}
