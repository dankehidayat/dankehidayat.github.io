---
import { workTimeline } from '../data/experience';
import SectionHeading from './SectionHeading.astro';
---

<SectionHeading
    id="experience"
    title="Work Experience"
    intro="Where I've worked and what I own, most recent first."
    variant="white"
>
    <ol class="exp-list">
        {
            workTimeline.map((item) => (
                <li class="exp-row" data-row>
                    <div class="exp-period">
                        {item.period}
                    </div>
                    <div class="exp-main">
                        <h3 class="exp-role">{item.title}</h3>
                        <p class="exp-org">
                            {item.org}
                            <span class="exp-org-loc"> · {item.location}</span>
                        </p>
                        {item.summary && <p class="exp-summary">{item.summary}</p>}
                        {item.points && item.points.length > 0 && (
                            <ul class="exp-points">
                                {item.points.map((point) => (
                                    <li set:html={point.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
                                ))}
                            </ul>
                        )}
                    </div>
                </li>
            ))
        }
    </ol>
</SectionHeading>
