---
/**
 * Drawn icon set — one stroke weight (1.7), round caps, 24px grid.
 * Brand marks (github/bluesky/linkedin) are filled glyphs.
 */
type IconName =
    | 'close'
    | 'arrow-down'
    | 'arrow-right'
    | 'arrow-left'
    | 'external'
    | 'heart-filled'
    | 'github'
    | 'bluesky'
    | 'linkedin';

type Props = { name: IconName; class?: string; label?: string };

const { name, class: className, label } = Astro.props;

const strokeAttrs = {
    fill: 'none',
    stroke: 'currentColor',
    'stroke-width': 1.7,
    'stroke-linecap': 'round' as const,
    'stroke-linejoin': 'round' as const,
    width: 24,
    height: 24
};

const filledAttrs = { fill: 'currentColor', 'aria-hidden': 'true', width: 24, height: 24 };
---

{
    name === 'close' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={className} aria-hidden="true" {...strokeAttrs}>
            <path d="M5 5l14 14M19 5L5 19" />
        </svg>
    )
}
{
    name === 'arrow-down' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={className} aria-hidden="true" {...strokeAttrs}>
            <path d="M12 4v15M5.5 12.5L12 19l6.5-6.5" />
        </svg>
    )
}
{
    name === 'arrow-right' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={className} aria-hidden="true" {...strokeAttrs}>
            <path d="M4.5 12h15M13.5 6l6 6-6 6" />
        </svg>
    )
}
{
    name === 'arrow-left' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={className} aria-hidden="true" {...strokeAttrs}>
            <path d="M19.5 12h-15M10.5 6l-6 6 6 6" />
        </svg>
    )
}
{
    name === 'external' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={className} aria-hidden="true" {...strokeAttrs}>
            <path d="M13.5 4.5H19.5V10.5M19 5L11 13" />
            <path d="M19.5 14.5V18A2.5 2.5 0 0 1 17 20.5H6A2.5 2.5 0 0 1 3.5 18V7A2.5 2.5 0 0 1 6 4.5H9.5" />
        </svg>
    )
}
{
    name === 'heart-filled' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={className} aria-hidden="true" {...filledAttrs}>
            <path d="M12 20.2C8.6 17.6 5.4 15 4.6 11.9 3.9 9.2 5.9 6.4 8.6 6.2c1.9-.1 3.1 1 3.4 2 .3-1 1.5-2.1 3.4-2 2.7.2 4.7 3 4 5.7-.8 3.1-4 5.7-7.4 8.3z" />
        </svg>
    )
}
{
    name === 'github' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={className} {...filledAttrs}>
            <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.94.85.09-.66.35-1.12.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9v2.81c0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" />
        </svg>
    )
}
{
    name === 'bluesky' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={className} {...filledAttrs}>
            <path d="M12 10.8c-1.56-3.1-4.15-5.77-6.97-6.77C2.62 3.2 1.8 4.12 1.8 5.34c0 .35.02.7.06 1.06.38 3.9 2.1 6.43 5.02 7.33-.3.04-.62.06-.94.06-2.5 0-4.44-1.2-5.2-3.44-.11-.33-.28-.4-.53-.4C-.13 9.93 0 10.27 0 10.6c0 3.05 2.57 6.1 6.34 6.1.31 0 .62-.02.92-.07l.12-.03c.35-.06.66-.12.95-.2.58-.16 1.1-.4 1.53-.7.77.74 1.85 1.16 3.06 1.16 2.04 0 3.87-.88 4.9-2.24.38.8.6 1.71.6 2.68 0 .3.03.62.08.93.04.29.22.42.46.42h.27C21.6 18.2 22 17.6 22 16.85c0-2.54-1.1-4.52-3.16-5.73-.42-.24-.9-.43-1.4-.58.15-.16.3-.34.44-.53 2.9-1.33 4.6-3.9 4.98-7.33l.06-.1c.04-.35.06-.7.06-1.05 0-1.2-.8-2.13-2.18-2.32-2.8-.96-5.4 3.65-6.8 6.75z" />
        </svg>
    )
}
{
    name === 'linkedin' && (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class={className} {...filledAttrs}>
            <path d="M6.94 5.5A1.94 1.94 0 1 1 5 3.56a1.94 1.94 0 0 1 1.94 1.94zM5.1 8.4h3.7V19H5.1zM10.5 8.4h3.54v1.45h.05c.5-.93 1.7-1.91 3.5-1.91 3.74 0 4.43 2.46 4.43 5.66V19h-3.7v-4.8c0-1.15-.02-2.62-1.6-2.62-1.6 0-1.85 1.25-1.85 2.53V19h-3.7z" />
        </svg>
    )
}
