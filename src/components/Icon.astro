---
/**
 * Icon set — sourced from @hugeicons/core-free-icons (stroke library).
 * Each icon is the vendor's official data, rendered at currentColor.
 */
import Cancel01Icon from '@hugeicons/core-free-icons/Cancel01Icon';
import ArrowDown01Icon from '@hugeicons/core-free-icons/ArrowDown01Icon';
import ArrowRight01Icon from '@hugeicons/core-free-icons/ArrowRight01Icon';
import ArrowLeft01Icon from '@hugeicons/core-free-icons/ArrowLeft01Icon';
import ExternalLinkIcon from '@hugeicons/core-free-icons/ExternalLinkIcon';
import HeartIcon from '@hugeicons/core-free-icons/HeartIcon';
import GithubIcon from '@hugeicons/core-free-icons/GithubIcon';
import BlueskyIcon from '@hugeicons/core-free-icons/BlueskyIcon';
import Linkedin01Icon from '@hugeicons/core-free-icons/Linkedin01Icon';
import { renderIconSvg } from '../lib/huge-icons';

type IconName =
    | 'close'
    | 'arrow-down'
    | 'arrow-right'
    | 'arrow-left'
    | 'external'
    | 'heart-filled'
    | 'github'
    | 'bluesky'
    | 'linkedin';

type Props = { name: IconName; class?: string; label?: string };

const { name, class: className, label } = Astro.props;

const icons: Record<IconName, string> = {
    close: renderIconSvg(Cancel01Icon),
    'arrow-down': renderIconSvg(ArrowDown01Icon),
    'arrow-right': renderIconSvg(ArrowRight01Icon),
    'arrow-left': renderIconSvg(ArrowLeft01Icon),
    external: renderIconSvg(ExternalLinkIcon),
    'heart-filled': renderIconSvg(HeartIcon),
    github: renderIconSvg(GithubIcon),
    bluesky: renderIconSvg(BlueskyIcon),
    linkedin: renderIconSvg(Linkedin01Icon)
};

const ariaAttrs = label ? { 'aria-label': label, role: 'img' as const } : { 'aria-hidden': 'true' };
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" class={className} {...ariaAttrs}>
    <Fragment set:html={icons[name]} />
</svg>
