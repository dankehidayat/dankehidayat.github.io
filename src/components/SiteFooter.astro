---
import siteConfig from '../data/site-config';

const year = new Date().getFullYear();

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const anchor = (hash: string) => (isHome ? hash : `/${hash}`);

const navLinks = [
    { text: 'About', href: anchor('#about') },
    { text: 'Experience', href: anchor('#experience') },
    { text: 'Stack', href: anchor('#stack') },
    { text: 'Projects', href: anchor('#projects') },
    { text: 'Notes', href: '/notes' },
    { text: 'Fun', href: '/fun' },
    { text: 'Stats', href: '/stats' }
];

const socials = (siteConfig.socialLinks ?? []).filter((l) => !l.href.includes('rss'));
---

<footer class="site-footer">
    <div class="site-shell">
        <div class="site-footer-inner">
            <div>
                <p class="footer-name">Danke Hidayat</p>
                <p class="footer-role">Software developer &amp; DevOps engineer</p>
                <p class="footer-note">
                    I build software for connected systems, from embedded firmware to the dashboards that watch over them, and I write about the work as I go.
                </p>
                <blockquote class="footer-quote">
                    <p class="footer-quote-text">“I was born to be the star.”</p>
                    <span class="footer-quote-by">Saijou Claudine · Revue Starlight</span>
                </blockquote>
            </div>
            <div class="footer-cols">
                <div>
                    <p class="footer-col-title">Sections</p>
                    <ul>
                        {navLinks.map((link) => (
                            <li><a href={link.href}>{link.text}</a></li>
                        ))}
                    </ul>
                </div>
                <div>
                    <p class="footer-col-title">Elsewhere</p>
                    <ul>
                        {socials.map((link) => (
                            <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.text}</a></li>
                        ))}
                        <li><a href="/rss.xml">RSS</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>© {year} Danke Hidayat. Built with Astro.</p>
                <p class="footer-bottom-links">
                    <a href="/rss.xml">RSS</a>
                    <a href="/Resume_Danke_Hidayat.pdf">Resume</a>
                </p>
            </div>
        </div>
    </div>
</footer>
