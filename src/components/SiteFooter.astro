---
import siteConfig from '../data/site-config';
import type { Lang } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="site-shell">
        <div class="footer-grid">
            <div>
                <p class="footer-name">Danke Hidayat</p>
                <p class="footer-note">{t('footer.built')}</p>
                <p class="footer-copy">© {year}</p>
            </div>
            <div class="footer-cols">
                <div>
                    <p class="label-kicker">{t('nav.home')}</p>
                    <ul>
                        <li><a href={localePath(lang, '/about')}>{t('nav.about')}</a></li>
                        <li><a href={localePath(lang, '/experience')}>{t('nav.experience')}</a></li>
                        <li><a href={localePath(lang, '/projects')}>{t('nav.projects')}</a></li>
                        <li><a href={localePath(lang, '/blog')}>{t('nav.blog')}</a></li>
                        <li><a href={localePath(lang, '/contact')}>{t('nav.contact')}</a></li>
                    </ul>
                </div>
                <div>
                    <p class="label-kicker">{t('contact.social')}</p>
                    <ul>
                        {
                            siteConfig.socialLinks?.map((l) => (
                                <li>
                                    <a href={l.href}>{l.text}</a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</footer>
