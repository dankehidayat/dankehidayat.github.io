---
import Icon from './Icon.astro';
import type { FunEntry } from '../data/fun';

type Props = {
    entry: FunEntry;
};

const { entry } = Astro.props;
const src = `/fun/covers/${entry.cover ?? entry.slug}.jpg`;
const label = entry.english ? `${entry.title} (${entry.english})` : entry.title;
---

<button type="button" class="fun-card" data-slug={entry.slug} aria-label={`Open details for ${label}`}>
    <span class="fun-cover">
        <img
            src={src}
            alt={`Cover of ${entry.title}`}
            width="460"
            height="690"
            loading="lazy"
            decoding="async"
        />
        {entry.badge && (
            <span class:list={['fun-heart', entry.badge === 'all-time' && 'fun-heart-all']}>
                <Icon name="heart-filled" />
                <span class="sr-only">
                    {entry.badge === 'all-time' ? 'All-time favorite' : 'Favorite'}
                </span>
            </span>
        )}
        <span class="fun-open" aria-hidden="true">
            <Icon name="arrow-right" />
            Details
        </span>
    </span>
    <span class="fun-title">{entry.title}</span>
</button>

<style>
    .fun-card {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        padding: 0;
        border: 0;
        background: none;
        text-align: left;
        font: inherit;
        color: inherit;
        cursor: pointer;
        min-width: 0;
    }

    .fun-cover {
        position: relative;
        display: block;
        aspect-ratio: 2 / 3;
        border-radius: 10px;
        overflow: hidden;
        background: var(--color-surface-tint);
        border: 1px solid var(--color-border);
        box-shadow: 0 16px 28px -22px rgb(37 31 22 / 0.5);
        transition:
            transform 0.25s var(--ease),
            box-shadow 0.25s var(--ease);
    }

    .fun-cover img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s var(--ease);
    }

    .fun-card:hover .fun-cover,
    .fun-card:focus-visible .fun-cover {
        transform: translateY(-4px);
        box-shadow: 0 24px 36px -24px rgb(37 31 22 / 0.55);
    }

    .fun-card:hover .fun-cover img {
        transform: scale(1.045);
    }

    .fun-card:focus-visible .fun-cover {
        outline: 2px solid var(--color-green);
        outline-offset: 3px;
    }

    /* heart chip — tangerine for favorites, ink for all-time */
    .fun-heart {
        position: absolute;
        top: 0.55rem;
        right: 0.55rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.9rem;
        height: 1.9rem;
        border-radius: 50%;
        background: var(--color-tangerine);
        color: var(--color-ink-on-tangerine);
        box-shadow: 0 8px 16px -8px rgb(46 22 8 / 0.5);
        z-index: 1;
    }

    .fun-heart-all {
        background: var(--color-ink);
        color: var(--color-bg);
    }

    /* hover affordance — small pill that says the card opens */
    .fun-open {
        position: absolute;
        left: 0.6rem;
        bottom: 0.6rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        background: var(--color-ink);
        color: var(--color-bg);
        font-family: var(--font-mono);
        font-size: 0.6rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0;
        transform: translateY(4px);
        transition:
            opacity 0.25s var(--ease),
            transform 0.25s var(--ease);
    }

    .fun-card:hover .fun-open,
    .fun-card:focus-visible .fun-open {
        opacity: 1;
        transform: translateY(0);
    }

    .fun-title {
        margin: 0;
        font-family: var(--font-display);
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: -0.01em;
        color: var(--color-ink);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
