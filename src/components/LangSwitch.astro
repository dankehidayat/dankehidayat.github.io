---
import { languages, type Lang } from '../i18n/ui';
import { switchLocalePath, useTranslations } from '../i18n/utils';

type Props = { lang: Lang; class?: string };
const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
const other = (Object.keys(languages) as Lang[]).filter((l) => l !== lang);
---

<div class:list={['lang-switch', className]} role="group" aria-label={t('lang.label')}>
    <span class="lang-current">{lang.toUpperCase()}</span>
    {
        other.map((l) => (
            <a href={switchLocalePath(Astro.url, l)} class="lang-other" hreflang={l} lang={l}>
                {l.toUpperCase()}
            </a>
        ))
    }
</div>
