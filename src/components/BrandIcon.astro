---
/**
 * Brand marks + generic glyphs for the tech stack and certification lists.
 * Brand marks are filled paths from simple-icons (each vendor's official hex);
 * generic glyphs are stroke icons from @hugeicons/core-free-icons.
 */
import Database01Icon from '@hugeicons/core-free-icons/Database01Icon';
import Plug01Icon from '@hugeicons/core-free-icons/Plug01Icon';
import BracketsIcon from '@hugeicons/core-free-icons/BracketsIcon';
import Layers01Icon from '@hugeicons/core-free-icons/Layers01Icon';
import BoltIcon from '@hugeicons/core-free-icons/BoltIcon';
import Hexagon01Icon from '@hugeicons/core-free-icons/Hexagon01Icon';
import CircuitBoardIcon from '@hugeicons/core-free-icons/CircuitBoardIcon';
import WaveIcon from '@hugeicons/core-free-icons/WaveIcon';
import Diamond01Icon from '@hugeicons/core-free-icons/Diamond01Icon';
import Wifi01Icon from '@hugeicons/core-free-icons/Wifi01Icon';
import { renderIconSvg } from '../lib/huge-icons';
import { brandIcons } from '../data/brand-icons';

type Props = { name: string; size?: string; class?: string };

const { name, size = '1rem', class: className } = Astro.props;

const def = brandIcons[name];

const glyphIcons: Record<string, string> = {
    database: renderIconSvg(Database01Icon),
    plug: renderIconSvg(Plug01Icon),
    brackets: renderIconSvg(BracketsIcon),
    layers: renderIconSvg(Layers01Icon),
    bolt: renderIconSvg(BoltIcon),
    hexagon: renderIconSvg(Hexagon01Icon),
    circuit: renderIconSvg(CircuitBoardIcon),
    wave: renderIconSvg(WaveIcon),
    diamond: renderIconSvg(Diamond01Icon),
    iot: renderIconSvg(Wifi01Icon)
};
---

{
    def?.kind === 'brand' && def.path && (
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width={size}
            height={size}
            class={className}
            aria-hidden="true"
        >
            <path d={def.path} fill={def.hex} />
        </svg>
    )
}
{
    def?.kind === 'glyph' && def.glyph && glyphIcons[def.glyph] && (
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width={size}
            height={size}
            class={className}
            aria-hidden="true"
            fill="none"
        >
            <Fragment set:html={glyphIcons[def.glyph]} />
        </svg>
    )
}