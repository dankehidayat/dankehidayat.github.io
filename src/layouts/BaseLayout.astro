---
/**
 * THESIS: Warm Signal — a warm, saturated editorial-technical portfolio; warm paper field, leaf-green/tangerine/saffron tricolor, Bricolage display lockup.
 * OWN-WORLD: #FBF5EA paper, #1E6B4A green, #E05D1E tangerine, #E5A81C saffron; ledger rows and signal ticks, no costume.
 * STORY: Meet a precise engineer, scan the shipped systems, reach him by email.
 * FIRST VIEWPORT: Green signal field, Bricolage name lockup, polaroid portrait in a paper frame with a Leica-style watermark, two actions.
 * FORM: Warm Signal · user-pinned (no costume, colorful/warm) · light-only, no dark mode.
 */
import { ClientRouter } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';

export type Props = HeadProps;

const { ...head } = Astro.props;
---

<!doctype html>
<html lang="en" class="antialiased">
    <head>
        <BaseHead {...head} />
        <ClientRouter />
    </head>
    <body class="min-h-dvh">
        <!--
          THESIS: A reading life, catalogued. Shelf files manga, anime, light novels and books
          as cards in a drawer; the drawer opens to what is on the desk now. Refuses the uniform cover grid.
          OWN-WORLD: Warm Signal, fixed. #FBF5EA paper drawer, #1E6B4A/#E05D1E/#E5A81C stamps,
          Bricolage titles, Source Sans body, JetBrains Mono shelfmarks, hairline ledger rules, monogram tiles.
          STORY: Open the drawer, see what he is reading, browse by stamped category, pull a card for the note and links.
          FIRST VIEWPORT: Shelf title and lead; three horizontal on-the-desk cards span below;
          then drawer counts and label chips; catalog rows beneath.
          FORM: Catalog card drawer — candidate 5 of 7 grounded structures, seed key 1a18a741;
          world user-pinned; Setup extends the same ledger language.
          FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
        -->
        <a class="skip-link" href="#main">Skip to content</a>
        <div class="flex min-h-dvh flex-col">
            <SiteNav />
            <main id="main" class="grow">
                <slot />
            </main>
            <SiteFooter />
        </div>
    </body>
</html>
