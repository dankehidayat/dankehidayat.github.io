---
/**
 * THESIS: Night Signal — bold type as live telemetry; refuse square gallery cards and cream SaaS.
 * OWN-WORLD: Deep lab field, mint signal, ember warmth, soft organic modules, Unbounded + Manrope.
 * STORY: Feel Danke's personality, trust the shipped systems, start a conversation.
 * FIRST VIEWPORT: Oversized name typeset + claim; soft blob portrait; primary CTA.
 * FORM: Night Signal · grounded #5 live telemetry status wall × soft chromatophore modules · seed 5d8702a8.
 */
import { ClientRouter } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import type { Lang } from '../i18n/ui';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

export type Props = HeadProps & { lang?: Lang };

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { ...head } = Astro.props;
---

<!doctype html>
<html lang={lang} class="antialiased">
    <head>
        <BaseHead {...head} lang={lang} />
        <ClientRouter />
    </head>
    <body class="min-h-dvh text-ink">
        <!--
          THESIS: Night Signal — bold typeset hero as live status, organic soft modules, not square gallery.
          OWN-WORLD: Deep field #0c0e14, mint signal, ember accent, Unbounded display + Manrope UI, pill controls.
          STORY: Meet Danke, scan real work, email him.
          FIRST VIEWPORT: Split name stack + claim + soft portrait vessel + CTAs.
          FORM: Night Signal · grounded #5 · seed 5d8702a8 · type-led hero.
        -->
        <a class="skip-link" href="#main">{t('theme.skip')}</a>
        <div class="flex min-h-dvh flex-col">
            <SiteNav lang={lang} />
            <main id="main" class="site-shell grow pb-20 pt-8 md:pb-28 md:pt-12">
                <slot />
            </main>
            <SiteFooter lang={lang} />
        </div>
        <script>
            import '../scripts/motion.ts';
        </script>
    </body>
</html>
