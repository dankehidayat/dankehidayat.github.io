---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';
import FormattedDate from '../../components/FormattedDate.astro';
import Icon from '../../components/Icon.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
    const postCount = posts.length;
    return posts.map((post, index) => ({
        params: { id: post.id },
        props: {
            post,
            prevPost: index + 1 !== postCount ? posts[index + 1] : null,
            nextPost: index !== 0 ? posts[index - 1] : null
        }
    }));
}

type Props = {
    post: CollectionEntry<'blog'>;
    prevPost: CollectionEntry<'blog'> | null;
    nextPost: CollectionEntry<'blog'> | null;
};

const { post, prevPost, nextPost } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags = [], seo } = post.data;
const { Content } = await render(post);

const words = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 200));
---

<BaseLayout
    title={seo?.title ?? title}
    description={seo?.description ?? excerpt}
    image={seo?.image}
    pageType="article"
>
    <article class="content-page reading-column">
        <a href="/notes" class="post-back">
            <Icon name="arrow-left" aria-hidden="true" />
            All notes
        </a>

        <header>
            <div class="post-meta">
                <FormattedDate date={publishDate} />
                <span class="dot" aria-hidden="true" />
                <span>{readingMinutes} min read</span>
                {
                    updatedDate && (
                        <>
                            <span class="dot" aria-hidden="true" />
                            <span>
                                Updated <FormattedDate date={updatedDate} />
                            </span>
                        </>
                    )
                }
            </div>
            <h1 class="post-title">{title}</h1>
            {excerpt && <p class="page-lede">{excerpt}</p>}
        </header>

        <div class="prose">
            <Content />
        </div>
        <script>
            import '../../scripts/code-blocks.ts';
        </script>

        {
            tags.length > 0 && (
                <div class="post-tags">
                    {tags.map((tag) => <span class="tag-chip">{tag}</span>)}
                </div>
            )
        }
    </article>

    {
        (prevPost || nextPost) && (
            <nav class="post-nav reading-column" aria-label="More notes">
                {nextPost ? (
                    <a href={`/notes/${nextPost.id}/`} class="post-nav-link">
                        <span class="post-nav-label">Next</span>
                        <span class="post-nav-title">{nextPost.data.title}</span>
                    </a>
                ) : (
                    <span class="post-nav-link post-nav-link-empty" aria-hidden="true" />
                )}
                {prevPost ? (
                    <a href={`/notes/${prevPost.id}/`} class="post-nav-link">
                        <span class="post-nav-label">Previous</span>
                        <span class="post-nav-title">{prevPost.data.title}</span>
                    </a>
                ) : (
                    <span class="post-nav-link post-nav-link-empty" aria-hidden="true" />
                )}
            </nav>
        )
    }
</BaseLayout>
