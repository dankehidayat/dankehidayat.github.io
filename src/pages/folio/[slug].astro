---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MarqueeBand from '../../components/MarqueeBand.astro';
import PlateFigure from '../../components/PlateFigure.astro';
import Icon from '../../components/Icon.astro';
import { PLATE_IMAGES } from '../../data/folio-plates';
import {
    FOLIO_WORK_IDS,
    PLATE_LABELS,
    PROJECT_SHOTS,
    SHOT_PLATES,
    plateNumberOf,
    type FolioWorkId,
    type ShotPlate
} from '../../data/works';
import { projectMeta } from '../../data/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { responsiveImage } from '../../lib/responsive-image';

export async function getStaticPaths() {
    const all = await getCollection('projects');
    const folio = FOLIO_WORK_IDS.map((id) => all.find((p) => p.id === id)).filter(
        (p): p is NonNullable<typeof p> => Boolean(p)
    );

    return folio.map((entry, index) => {
        const related = [folio[(index + 1) % folio.length], folio[(index + 2) % folio.length], folio[(index + 3) % folio.length]];
        return {
            params: { slug: entry.id },
            props: { entry, related }
        };
    });
}

type Props = {
    entry: CollectionEntry<'projects'>;
    related: CollectionEntry<'projects'>[];
};

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const meta = projectMeta[entry.id];
const number = plateNumberOf(entry.id);
const label = PLATE_LABELS[entry.id as keyof typeof PLATE_LABELS];

const issued = entry.data.publishDate.toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric'
});

/**
 * The documentation plate: the project's own record, straight from
 * PROJECT_SHOTS (src/data/works.ts). No plate, no frame — a project without a
 * shot simply doesn't get the figure rather than an empty hatched box.
 */
const shot = PROJECT_SHOTS[entry.id as FolioWorkId];

/** What each shot shows and how to name it: SHOT_PLATES, read off the actual
 *  pixels in src/data/works.ts. A project with no entry gets the neutral
 *  fallback below — never a guess. */
const shotNote: ShotPlate = {
    stamp: 'Project record',
    alt: `An image from the ${entry.data.title} project record.`
};

const plateNote = SHOT_PLATES[entry.id] ?? shotNote;

/**
 * The record sheet's documentation plate runs the full width of the sheet —
 * up to 67rem inside the 72rem shell — well past the 27rem marquee slot
 * SHOT_WIDTHS was tuned for, so this page declares its own ladder. The helper
 * still caps every rung at the master's own width, so nothing upscales. Move
 * it into src/lib/responsive-image.ts with the other slot ladders when that
 * lane is open.
 *
 * `sizes` mirrors the shell exactly: 72rem wide with clamp(1.25rem, 4vw,
 * 2.5rem) of side padding, so 67rem above 1180px, 100vw − 5rem once 4vw has
 * clamped to 2.5rem, then 92vw, then 88vw below 500px.
 */
const RECORD_SHOT_WIDTHS = [480, 800, 1160, 1600];
const RECORD_SHOT_SIZES = '(min-width: 1180px) 67rem, (min-width: 1000px) calc(100vw - 5rem), (min-width: 500px) 92vw, 88vw';

const shotPlate = shot ? await responsiveImage(shot, { widths: RECORD_SHOT_WIDTHS, quality: 82 }) : null;

/** A master under ~480px (Eco Office is 255×191) is shown at its own size, never blown up. */
const shotIsSmall = Boolean(shot && shot.width < 480);

const marqueeItems = [
    { text: `Record ${number}`, italic: true },
    { text: entry.data.title, italic: true },
    { text: `Collected ${issued}` },
    { text: 'Botanical folio' }
];
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
    <article class="plate-detail site-shell">
        <a class="folio-back" href="/folio">
            <Icon name="arrow-left" aria-hidden="true" />
            All records
        </a>

        <header class="plate-detail-head" data-hero>
            <figure class="plate-detail-figure" data-hero-plate>
                <PlateFigure
                    number={number}
                    name={entry.data.title}
                    label={label}
                    id={entry.id}
                    variant="featured"
                    image={PLATE_IMAGES[entry.id]}
                />
            </figure>

            <div class="plate-detail-meta" data-hero-item>
                <h1 class="plate-detail-title">{entry.data.title}</h1>
                {entry.data.description && <p class="plate-detail-desc">{entry.data.description}</p>}
                <p class="plate-detail-issued">Collected {issued}</p>

                {
                    meta?.tech?.length ? (
                        <ul class="plate-detail-tech">
                            {meta.tech.map((tech) => (
                                <li class="tag-chip">{tech}</li>
                            ))}
                        </ul>
                    ) : null
                }

                {
                    meta?.links?.length ? (
                        <div class="plate-detail-links">
                            {meta.links.map((link) => (
                                <a class="plate-link" href={link.href} target="_blank" rel="noopener noreferrer">
                                    {link.label}
                                    <span class="plate-link-rule" aria-hidden="true" />
                                    <Icon name="external" aria-hidden="true" />
                                    <span class="sr-only">(opens in new tab)</span>
                                </a>
                            ))}
                        </div>
                    ) : null
                }
            </div>
        </header>

        {/* the record sheet — the sheet proper, centred inside the shell so
            the evidence and the story sit on one axis instead of hanging
            off the left edge */}
        <div class="plate-detail-sheet">
            {
                shotPlate && (
                    <figure class:list={['doc-plate', shotIsSmall && 'doc-plate--small']} data-reveal="rule">
                        <div class="doc-frame">
                            <img
                                src={shotPlate.src}
                                srcset={shotPlate.srcset}
                                sizes={RECORD_SHOT_SIZES}
                                width={shotPlate.width}
                                height={shotPlate.height}
                                alt={plateNote.alt}
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                        <figcaption class="doc-cap">
                            <span class="doc-fig">Fig. {number}</span>
                            <span class="doc-name">{entry.data.title}</span>
                            <span class="doc-stamp">{plateNote.stamp}</span>
                        </figcaption>
                    </figure>
                )
            }

            <div class="plate-detail-body">
                <div class="prose">
                    <Content />
                </div>
                <span class="record-fleuron" aria-hidden="true">
                    <svg class="floret" viewBox="0 0 24 24">
                        <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" fill="none">
                            <path d="M12 2.5v19M3.77 7.25l16.46 9.5M3.77 16.75l16.46-9.5" />
                        </g>
                        <circle cx="12" cy="12" r="1.7" fill="currentColor" />
                    </svg>
                </span>
            </div>
        </div>

        {
            related.length > 0 && (
                <section class="related" aria-label="Adjacent records">
                    <div class="related-head" data-head>
                        <h2 class="related-title">Adjacent records</h2>
                        <span class="related-note">More from the folio</span>
                    </div>
                    <div class="plate-grid" data-plate-group>
                        {related.map((work) => (
                            <PlateFigure
                                number={plateNumberOf(work.id)}
                                name={work.data.title}
                                label={PLATE_LABELS[work.id as keyof typeof PLATE_LABELS]}
                                id={work.id}
                                href={`/folio/${work.id}/`}
                                variant="mini"
                                image={PLATE_IMAGES[work.id]}
                            />
                        ))}
                    </div>
                </section>
            )
        }
    </article>

    <MarqueeBand items={marqueeItems} />
</BaseLayout>

<script>
    import '../../scripts/defer-motion.ts';
</script>
