---
import { getCollection } from 'astro:content';
import ChapterRail from '../../components/ChapterRail.astro';
import MarqueeBand from '../../components/MarqueeBand.astro';
import PlateFigure from '../../components/PlateFigure.astro';
import ScreenshotMarquee from '../../components/ScreenshotMarquee.astro';
import Icon from '../../components/Icon.astro';
import { PLATE_IMAGES } from '../../data/folio-plates';
import { EXTRA_LILIES } from '../../data/extra-lilies';
import {
    FOLIO_WORK_IDS,
    PLATE_LABELS,
    PROJECT_SHOTS,
    WORK_CATEGORIES,
    plateNumberOf
} from '../../data/works';
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Folio';
const description =
    'Six works at equal scale: IoT dashboards, environmental monitors, and embedded systems, presented as plates of a botanical folio.';

const allProjects = await getCollection('projects');
const folioWorks = FOLIO_WORK_IDS.map((id) => allProjects.find((p) => p.id === id)).filter(
    (p): p is NonNullable<typeof p> => Boolean(p)
);
const workById = new Map(folioWorks.map((work) => [work.id, work]));

const categories = WORK_CATEGORIES.map((category) => ({
    ...category,
    works: category.works
        .map((id) => workById.get(id))
        .filter((work): work is NonNullable<typeof work> => Boolean(work))
}));

const shotItems = folioWorks.map((work) => {
    const shot = PROJECT_SHOTS[work.id as keyof typeof PROJECT_SHOTS];
    return {
        number: plateNumberOf(work.id),
        name: work.data.title,
        src: shot?.src,
        width: shot?.width,
        height: shot?.height
    };
});

const marqueeItems = [
    { text: 'The folio · plates 01–06' },
    { text: 'Observed. Built. Preserved.' },
    { text: 'Equal scale' },
    { text: 'One baseline' }
];

const chapters = [
    { num: '001', label: 'Folio', href: '#top' },
    { num: '002', label: 'Contents', href: '#contents' },
    { num: '003', label: 'Web apps', href: '#web-apps' },
    { num: '004', label: 'IoT', href: '#iot' }
];

// Margin lily — the colophon plate from extra-lilies.json (the head is a
// featured title plate, same treatment as the florilegium/atelier heroes).
const { superbum, catesbaei } = EXTRA_LILIES;
---

<BaseLayout title={title} description={description}>
    <ChapterRail chapters={chapters} />
    <div class="works-page site-shell">
        <header class="works-head works-head--viewport" id="top" data-head data-hero>
            <div class="works-head-copy">
                <h1 class="works-title">The <em>folio.</em></h1>
                <p class="works-lede">
                    Every plate printed at the same scale on plate cream: dashboards,
                    sensors, and sorting bins from Selene to HydroleVI. Open any plate for
                    its full record.
                </p>
            </div>

            <!-- the folio title plate — same featured treatment as the
                 florilegium and atelier heroes (round 4: the old margin
                 lily was half their size) -->
            <figure class="folio-hero-plate works-head-plate" data-hero-plate>
                <PlateFigure
                    number="001"
                    name={catesbaei.species}
                    label={catesbaei.source}
                    id="lilium-catesbaei"
                    variant="featured"
                    image={catesbaei}
                />
            </figure>
        </header>

        <nav
            class="works-contents"
            id="contents"
            aria-label="Plate contents"
            data-reveal="rule"
        >
            <p class="works-contents-label">Contents</p>
            {
                categories.map((category) => (
                    <div class="works-contents-group">
                        <h2 class="works-contents-cat" id={`contents-${category.id}`}>
                            <em>{category.name}</em>
                        </h2>
                        <ol class="works-contents-list">
                            {category.works.map((work) => (
                                <li class="works-contents-row" data-row>
                                    <a href={`/folio/${work.id}/`}>
                                        <span class="works-contents-num">
                                            {plateNumberOf(work.id)}
                                        </span>
                                        <span class="works-contents-name">
                                            {work.data.title}
                                        </span>
                                        <Icon name="arrow-right" aria-hidden="true" />
                                    </a>
                                </li>
                            ))}
                        </ol>
                    </div>
                ))
            }
        </nav>

        {
            categories.map((category) => (
                <section
                    class="works-category"
                    id={category.id}
                    aria-labelledby={`cat-${category.id}`}
                >
                    <header class="zoom-head">
                        <h2 class="zoom-title" id={`cat-${category.id}`}>
                            <em>{category.name}</em>
                        </h2>
                        <p class="zoom-note">{category.note}</p>
                        <span class="zoom-count">
                            {String(category.works.length).padStart(2, '0')} plates
                        </span>
                    </header>
                    <div class="plate-grid plate-grid--works" data-plate-group>
                        {category.works.map((work) => (
                            <PlateFigure
                                number={plateNumberOf(work.id)}
                                name={work.data.title}
                                label={PLATE_LABELS[work.id as keyof typeof PLATE_LABELS]}
                                id={work.id}
                                href={`/folio/${work.id}/`}
                                variant="cell"
                                description={work.data.description}
                                cta="View plate"
                                image={PLATE_IMAGES[work.id]}
                            />
                        ))}
                    </div>
                </section>
            ))
        }

        <!-- closing margin plate + colophon note (extra-lilies.json) -->
        <div class="works-colophon" data-reveal>
            <figure class="lily-accent works-colophon-plate">
                <span class="lily-accent-frame">
                    <img
                        src={superbum.src.src}
                        width={superbum.src.width}
                        height={superbum.src.height}
                        alt={superbum.alt}
                        loading="lazy"
                        decoding="async"
                    />
                </span>
                <figcaption class="lily-accent-cap">
                    <em>{superbum.species}</em>
                    <span class="lily-accent-src">{superbum.source}</span>
                </figcaption>
            </figure>
            <p class="works-colophon-note">
                “Fair daffodils, we weep to see / You haste away so soon;” · Robert
                Herrick, “To Daffodils”
            </p>
        </div>

        <div class="works-foot" data-reveal>
            <a href="/#contact" class="folio-text-link">
                Write me
                <Icon name="arrow-right" aria-hidden="true" />
            </a>
        </div>
    </div>

    <ScreenshotMarquee shots={shotItems} />
    <MarqueeBand items={marqueeItems} />
</BaseLayout>

<style>
    .works-category {
        margin-top: clamp(3rem, 7vw, 5rem);
        padding-top: clamp(2rem, 5vw, 3.25rem);
        border-top: 1px solid var(--color-border);
    }

    .works-contents-group + .works-contents-group {
        margin-top: 1.1rem;
        padding-top: 1.1rem;
        border-top: 1px solid var(--color-border);
    }

    .works-contents-cat {
        margin: 0 0 0.5rem;
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-ink);
    }

    .works-contents-cat em {
        font-style: italic;
        font-weight: 500;
        color: var(--color-green);
    }
</style>

<script>
    import '../../scripts/motion.ts';
</script>
