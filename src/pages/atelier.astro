---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterRail from '../components/ChapterRail.astro';
import Icon from '../components/Icon.astro';
import PlateFigure from '../components/PlateFigure.astro';
import { setupHardware, setupTools, setupRepos } from '../data/setup';
import { ATELIER_PLATE_IMAGE } from '../data/folio-plates';
import {
    ATELIER_SHOT_WIDTHS,
    ATELIER_THEME_WIDTHS,
    responsiveImage
} from '../lib/responsive-image';
import archrice from '../assets/images/atelier/archrice.jpg';
import neovimDawn from '../assets/images/atelier/neovim_rose-pine-dawn.webp';
import neovimMain from '../assets/images/atelier/neovim_rose-pine-main.webp';
import openboxDesktop from '../assets/images/atelier/openbox-desktop.jpg';
import openboxSddm from '../assets/images/atelier/openbox-sddm.jpg';
import rice2020 from '../assets/images/atelier/rice-2020.jpg';
import rice2021 from '../assets/images/atelier/rice-2021.jpg';
import rice2022 from '../assets/images/atelier/rice-2022.jpg';
import riceFlashbang from '../assets/images/atelier/rice-flashbang.jpg';
import riceMisc from '../assets/images/atelier/rice-misc.jpg';

const chapters = [
    { num: '001', label: 'Intro', href: '#top' },
    { num: '002', label: 'Desk', href: '#desk' },
    { num: '003', label: 'Daily', href: '#daily' },
    { num: '004', label: 'Archive', href: '#archive' }
];

const bySlug = (slug: string) => setupHardware.find((item) => item.slug === slug)!;

const machine = bySlug('macbook-pro');
const keyboard = bySlug('weikav-alice-record');
const stash = bySlug('switch-stash');
const mice = [
    bySlug('fantech-sakura-vx7'),
    bySlug('logitech-m170'),
    bySlug('tecware-torque-plus')
];
const mousepad = bySlug('fantech-sakura-mousepad');
const ears = [bySlug('moondrop-space-travel-2'), bySlug('cca-c10')];
const watch = bySlug('g-shock-ga-100');
const charger = bySlug('ugreen-36w-pd');

/** The editor sheet — Neovim's config as a pressed specimen sheet. */
const editorSheet = [
    {
        term: 'Base',
        text: 'lazy.nvim plugin manager. Space as leader, relative line numbers, persistent undo.'
    },
    {
        term: 'Theme',
        text: 'Ros\u00e9 Pine (dark main variant). Dim inactive windows, bold + italic enabled, no transparency.'
    },
    {
        term: 'UI',
        text: 'Bufferline with slant separators, Nerd Font icons, and LSP diagnostics inline. Snacks file explorer with sidebar offset.'
    },
    {
        term: 'Languages',
        text: 'TypeScript, Python, Go, Dart/Flutter, Docker, YAML, JSON, Markdown, Tailwind CSS. ESLint + Prettier formatting.'
    },
    {
        term: 'Flutter',
        text: 'flutter-tools.nvim with DAP debugging, widget guides, closing tags, dev log in a tab, and outline sidebar.'
    },
    {
        term: 'AI',
        text: 'CodeCompanion.nvim routed through 9Router (local OpenAI-compatible gateway). Chat, inline edits, code review, all from the terminal.'
    },
    {
        term: 'LSP',
        text: 'Auto-installed via Mason. HTML, CSS, Emmet, Bash, plus all LazyVim extras for the languages above.'
    },
    {
        term: 'Key maps',
        text: 'Ctrl-S to save, Esc to clear search, Shift-H/L for buffer cycling. leader+bp to pin a buffer, leader+aa for AI chat.'
    }
];

/**
 * Archive footage for the filmstrip — real screenshots, dated as given.
 * Static imports so each frame gets a width ladder: the filmstrip thumb is
 * clamp(13rem, 22vw, 18rem) but the same frame opens full-bleed in the
 * lightbox, so one ladder serves both via `sizes`.
 */
const archiveShots = [
    {
        image: archrice,
        label: 'The first desk \u00b7 2019',
        alt: 'Arch Linux desktop from 2019, from the Archrice repository',
        repo: { label: 'Archrice repo', href: 'https://github.com/nishimi-ya/Archrice' }
    },
    {
        image: rice2020,
        label: 'August 2020',
        alt: 'Desktop from August 2020'
    },
    {
        image: riceMisc,
        label: '2019\u20132022 \u00b7 miscellany',
        alt: 'Desktop from the 2019\u20132022 era'
    },
    {
        image: rice2021,
        label: 'April 2021',
        alt: 'Desktop from April 2021'
    },
    {
        image: rice2022,
        label: 'March 2022',
        alt: 'Desktop from March 2022'
    },
    {
        image: openboxDesktop,
        label: 'Openbox \u00b7 desktop',
        alt: 'Openbox desktop from the Openbox dotfiles branch',
        repo: {
            label: 'Openbox dotfiles',
            href: 'https://github.com/nishimi-ya/dotfiles/tree/openbox'
        }
    },
    {
        image: openboxSddm,
        label: 'Openbox \u00b7 lockscreen',
        alt: 'SDDM lockscreen from the Openbox dotfiles branch',
        repo: {
            label: 'Openbox dotfiles',
            href: 'https://github.com/nishimi-ya/dotfiles/tree/openbox'
        }
    }
];

/** One ladder per frame; the lightbox reuses it at a larger `sizes`. */
const archiveFrames = await Promise.all(
    archiveShots.map(async (shot) => {
        const frame = await responsiveImage(shot.image, {
            widths: ATELIER_SHOT_WIDTHS,
            quality: 76
        });
        // The anchor's href is the no-JS fallback and the lightbox target, so
        // it points at the widest rung rather than a mid-rung.
        const widest = frame.srcset.trim().split(',').pop()?.trim().split(' ')[0] ?? frame.src;
        return { ...shot, frame, href: widest };
    })
);

const deskPlate = await responsiveImage(riceFlashbang, {
    widths: ATELIER_SHOT_WIDTHS,
    quality: 76
});
const themeDawn = await responsiveImage(neovimDawn, {
    widths: ATELIER_THEME_WIDTHS,
    quality: 78
});
const themeMain = await responsiveImage(neovimMain, {
    widths: ATELIER_THEME_WIDTHS,
    quality: 78
});
---

<BaseLayout
    title="Atelier"
    description="The atelier: the MacBook Pro I work on, the desk around it, the programs I keep open, and the old Linux builds I left behind."
>
    <ChapterRail chapters={chapters} />

    <!-- ═══ hero ═══ -->
    <header class="folio-hero atelier-hero" id="top" data-chapter="top" data-hero>
        <div class="site-shell folio-hero-inner">
            <div class="folio-hero-copy">
                <h1 class="chapter-title atelier-title">The <em>atelier.</em></h1>
                <p class="atelier-lede" data-hero-item>
                    My MacBook, the things plugged into it, and the programs I keep open.
                </p>
                <p class="atelier-meta" data-hero-item>
                    <span>{machine.name}</span>
                    <svg class="floret" viewBox="0 0 24 24" aria-hidden="true">
                        <g
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                            fill="none"
                        >
                            <path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"></path>
                        </g>
                        <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
                    </svg>
                    <span>Bandung, Indonesia</span>
                </p>
            </div>

            <figure class="folio-hero-plate" data-hero-plate>
                <PlateFigure
                    number="001"
                    name="Nymphaea alba"
                    label="Flora Batava · 1830"
                    id="nymphaea-atelier"
                    variant="featured"
                    image={ATELIER_PLATE_IMAGE}
                />
            </figure>
        </div>

        <div class="site-shell setup-folio-rule" aria-hidden="true">
            <span></span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                    d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"></path>
                <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
            </svg>
            <span></span>
        </div>
    </header>

    <!-- ═══ chapter I · on the desk ═══ -->
    <section class="folio-chapter" id="desk" data-chapter="desk" aria-labelledby="desk-title">
        <div class="site-shell folio-chapter-inner">
            <header class="chapter-head" data-head>
                <h2 class="chapter-title" id="desk-title">On <em>the desk.</em></h2>
                <p class="chapter-intro">
                    Whatever is physically in front of me.
                </p>
            </header>

            <div class="desk-scene">
                <div class="desk-machine-wrap" data-drift="16">
                    <div class="desk-block desk-machine" data-reveal="blur">
                        <p class="desk-feature-name" data-no-split>{machine.name}</p>
                        <p class="desk-feature-role" data-no-split>{machine.role}</p>
                    </div>
                </div>

                <div class="desk-block desk-hands" data-reveal="blur">
                    <p class="desk-kicker" data-no-split>Hands</p>
                    <div class="desk-item desk-item--lead">
                        <p class="desk-name" data-no-split>{keyboard.name}</p>
                        <p class="desk-role" data-no-split>{keyboard.role}</p>
                    </div>
                    <p class="desk-sub" data-no-split>Mice</p>
                    <div class="desk-trio">
                        {
                            mice.map((item) => (
                                <div class="desk-item">
                                    <p class="desk-name" data-no-split>
                                        {item.name}
                                    </p>
                                    {item.role && (
                                        <p class="desk-role" data-no-split>
                                            {item.role}
                                        </p>
                                    )}
                                </div>
                            ))
                        }
                    </div>
                    <div class="desk-item desk-item--pad">
                        <p class="desk-name" data-no-split>{mousepad.name}</p>
                        <p class="desk-role" data-no-split>{mousepad.role}</p>
                    </div>
                </div>

                <div class="desk-block desk-ears" data-reveal="blur">
                    <p class="desk-kicker" data-no-split>Ears</p>
                    {
                        ears.map((item) => (
                            <div class="desk-item">
                                <p class="desk-name" data-no-split>
                                    {item.name}
                                </p>
                                <p class="desk-role" data-no-split>
                                    {item.role}
                                </p>
                            </div>
                        ))
                    }
                </div>

                <div class="desk-block desk-power" data-reveal="blur">
                    <p class="desk-kicker" data-no-split>Wrist &amp; power</p>
                    {
                        [watch, charger].map((item) => (
                            <div class="desk-item">
                                <p class="desk-name" data-no-split>
                                    {item.name}
                                </p>
                                <p class="desk-role" data-no-split>
                                    {item.role}
                                </p>
                            </div>
                        ))
                    }
                </div>

                <div class="desk-block desk-stash" data-reveal="blur">
                    <p class="desk-kicker" data-no-split>Spare switches</p>
                    <p class="desk-stash-line" data-no-split>
                        {stash.role?.replace(/\.$/, '')}
                        <span class="desk-stash-end">And that's the stash.</span>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══ chapter II · what I open all day ═══ -->
    <section class="folio-chapter" id="daily" data-chapter="daily" aria-labelledby="daily-title">
        <div class="site-shell folio-chapter-inner">
            <header class="chapter-head" data-head>
                <h2 class="chapter-title" id="daily-title">
                    What I <em>open all day.</em>
                </h2>
                <p class="chapter-intro">
                    Five programs, one of them a terminal editor. Nothing here needs a sales pitch.
                </p>
            </header>

            <div class="daily-grid">
                <ul class="tool-stack">
                    {
                        setupTools.map((tool) => (
                            <li class="tool-line" data-reveal="blur">
                                <a
                                    class="tool-link"
                                    href={tool.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <span class="tool-name" data-no-split>
                                        {tool.name}
                                    </span>
                                    {tool.role && (
                                        <span class="tool-role" data-no-split>
                                            {tool.role}
                                        </span>
                                    )}
                                    <Icon name="external" aria-hidden="true" />
                                    <span class="sr-only">(opens in a new tab)</span>
                                </a>
                            </li>
                        ))
                    }
                </ul>

                <div class="editor-sheet" data-reveal>
                    <p class="sheet-kicker" data-no-split>Editor sheet</p>
                    <p class="sheet-title" data-no-split>Neovim, on LazyVim</p>
                    <dl class="sheet-list">
                        {
                            editorSheet.map((row) => (
                                <div class="sheet-row">
                                    <dt>{row.term}</dt>
                                    <dd>{row.text}</dd>
                                </div>
                            ))
                        }
                    </dl>
                </div>
            </div>

            <!-- the editor's livery — one large frame that follows the
                 page's own theme: main when dark, dawn when light -->
            <figure class="theme-shot" data-reveal>
                <div class="theme-shot-frame">
                    <img
                        class="theme-shot-img theme-shot-img--dawn"
                        src={themeDawn.src}
                        srcset={themeDawn.srcset}
                        sizes="(min-width: 1180px) 72rem, 92vw"
                        alt="Neovim with the Rosé Pine dawn theme, light variant"
                        width={themeDawn.width}
                        height={themeDawn.height}
                        loading="lazy"
                        decoding="async"
                    />
                    <img
                        class="theme-shot-img theme-shot-img--main"
                        src={themeMain.src}
                        srcset={themeMain.srcset}
                        sizes="(min-width: 1180px) 72rem, 92vw"
                        alt="Neovim with the Rosé Pine main theme, dark variant"
                        width={themeMain.width}
                        height={themeMain.height}
                        loading="lazy"
                        decoding="async"
                    />
                </div>
                <figcaption class="theme-shot-cap">
                    <span class="theme-shot-name">
                        Rosé Pine ·
                        <em class="theme-shot-variant theme-shot-variant--dawn">dawn</em><em
                            class="theme-shot-variant theme-shot-variant--main">main</em>
                    </span>
                    <span class="theme-shot-note">
                        The editor's livery: this shot wears whichever variant your
                        theme is on.
                    </span>
                </figcaption>
            </figure>
        </div>
    </section>

    <!-- ═══ chapter III · the archive ═══ -->
    <section class="folio-chapter" id="archive" data-chapter="archive" aria-labelledby="archive-title">
        <div class="site-shell folio-chapter-inner">
            <header class="chapter-head" data-head>
                <h2 class="chapter-title" id="archive-title">
                    I used <em>to rice.</em>
                </h2>
                <p class="chapter-intro">
                    Arch, BSPWM, Hyprland: 2019 to 2022. I don't run it anymore; the
                    dotfiles are still up.
                </p>
            </header>

            <figure class="archive-desk" data-reveal>
                <div class="archive-desk-frame">
                    <img
                        class="archive-desk-img"
                        src={deskPlate.src}
                        srcset={deskPlate.srcset}
                        sizes="(min-width: 1180px) 72rem, 92vw"
                        alt="The bright BSPWM desktop from 2019"
                        width={deskPlate.width}
                        height={deskPlate.height}
                        loading="lazy"
                        decoding="async"
                        data-drift="14"
                    />
                </div>
                <figcaption class="setup-archive-caption">The flashbang, 2019.</figcaption>
            </figure>

            <div class="filmstrip" data-filmstrip aria-label="Archive screenshots, 2019 to 2022">
                <p class="filmstrip-label" data-no-split>
                    The archive · click any frame to enlarge
                </p>
                <div class="filmstrip-track" data-filmstrip-track>
                    {
                        archiveFrames.map((shot, i) => (
                            <a
                                class="filmstrip-item"
                                href={shot.href}
                                data-gallery-index={i}
                                data-gallery-label={shot.label}
                                data-gallery-srcset={shot.frame.srcset}
                                data-gallery-repo={shot.repo?.href}
                                data-gallery-repo-label={shot.repo?.label}
                                aria-label={`${shot.label}: view larger`}
                            >
                                <span class="filmstrip-frame">
                                    <img
                                        src={shot.frame.src}
                                        srcset={shot.frame.srcset}
                                        sizes="(min-width: 1180px) 18rem, (min-width: 640px) 22vw, min(70vw, 16rem)"
                                        alt={shot.alt}
                                        width={shot.frame.width}
                                        height={shot.frame.height}
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </span>
                                <span class="filmstrip-cap">{shot.label}</span>
                            </a>
                        ))
                    }
                </div>
            </div>

            <div class="repo-block" data-reveal>
                <p class="repo-kicker" data-no-split>Dotfiles</p>
                <div class="repo-row">
                    {
                        setupRepos.map((repo) => (
                            <a
                                class="repo-ticket"
                                href={repo.href}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <Icon name="github" aria-hidden="true" />
                                <span class="repo-ticket-label">{repo.label}</span>
                                <Icon name="external" aria-hidden="true" />
                                <span class="sr-only">(opens in a new tab)</span>
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>

    <dialog class="setup-gallery" id="setup-gallery" aria-label="Archive screenshot viewer">
        <button
            class="setup-gallery-close"
            id="setup-gallery-close"
            type="button"
            aria-label="Close viewer"
        >
            <Icon name="close" aria-hidden="true" />
        </button>
        <figure class="setup-gallery-figure">
            <img
                id="setup-gallery-img"
                src={archiveFrames[0].frame.src}
                srcset={archiveFrames[0].frame.srcset}
                sizes="100vw"
                alt={archiveFrames[0].alt}
                width={archiveFrames[0].frame.width}
                height={archiveFrames[0].frame.height}
            />
            <figcaption class="setup-gallery-caption">
                <span id="setup-gallery-label"></span>
                <span class="setup-gallery-caption-end">
                    <a
                        class="setup-gallery-link"
                        id="setup-gallery-link"
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        hidden
                    >
                        <span id="setup-gallery-link-text">dotfiles</span>
                        <Icon name="external" aria-hidden="true" />
                    </a>
                    <span id="setup-gallery-pos"></span>
                </span>
            </figcaption>
        </figure>
        <div class="setup-gallery-nav">
            <button
                class="setup-gallery-btn"
                id="setup-gallery-prev"
                type="button"
                aria-label="Previous screenshot"
            >
                <Icon name="arrow-left" aria-hidden="true" />
            </button>
            <button
                class="setup-gallery-btn"
                id="setup-gallery-next"
                type="button"
                aria-label="Next screenshot"
            >
                <Icon name="arrow-right" aria-hidden="true" />
            </button>
        </div>
    </dialog>

    <script>
        function bindSetup() {
            // Filmstrip frames open an in-page viewer instead of navigating.
            const dialog = document.getElementById('setup-gallery') as HTMLDialogElement | null;
            const thumbs = Array.from(
                document.querySelectorAll<HTMLAnchorElement>('.filmstrip-item')
            );
            if (!dialog || thumbs.length === 0) return;

            const img = document.getElementById('setup-gallery-img') as HTMLImageElement;
            const label = document.getElementById('setup-gallery-label') as HTMLElement;
            const pos = document.getElementById('setup-gallery-pos') as HTMLElement;
            const link = document.getElementById('setup-gallery-link') as HTMLAnchorElement;
            const linkText = document.getElementById('setup-gallery-link-text') as HTMLElement;
            const shots = thumbs.map((a) => ({
                src: a.href,
                srcset: a.dataset.gallerySrcset ?? '',
                label: a.dataset.galleryLabel ?? '',
                alt: a.querySelector('img')?.alt ?? '',
                repo: a.dataset.galleryRepo
                    ? { href: a.dataset.galleryRepo, label: a.dataset.galleryRepoLabel ?? 'dotfiles' }
                    : null
            }));
            let current = 0;

            const render = () => {
                const shot = shots[current];
                img.src = shot.src;
                // The same ladder the thumb uses, read at the lightbox's width.
                if (shot.srcset) {
                    img.srcset = shot.srcset;
                    img.sizes = '100vw';
                } else {
                    img.removeAttribute('srcset');
                }
                img.alt = shot.alt;
                label.textContent = shot.label;
                pos.textContent = `${current + 1} / ${shots.length}`;
                if (shot.repo) {
                    link.href = shot.repo.href;
                    linkText.textContent = shot.repo.label;
                    link.hidden = false;
                } else {
                    link.hidden = true;
                }
            };

            thumbs.forEach((a, i) => {
                a.addEventListener('click', (e) => {
                    e.preventDefault();
                    current = i;
                    render();
                    dialog.showModal();
                });
            });

            document.getElementById('setup-gallery-prev')?.addEventListener('click', () => {
                current = (current - 1 + shots.length) % shots.length;
                render();
            });
            document.getElementById('setup-gallery-next')?.addEventListener('click', () => {
                current = (current + 1) % shots.length;
                render();
            });
            document.getElementById('setup-gallery-close')?.addEventListener('click', () => {
                dialog.close();
            });

            // Clicking the dialog chrome (outside the figure) closes it.
            dialog.addEventListener('click', (e) => {
                if (e.target === dialog) dialog.close();
            });

            dialog.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    current = (current - 1 + shots.length) % shots.length;
                    render();
                } else if (e.key === 'ArrowRight') {
                    e.preventDefault();
                    current = (current + 1) % shots.length;
                    render();
                }
            });
        }
        // astro:page-load fires on the initial load and after every view-transition navigation.
        document.addEventListener('astro:page-load', bindSetup);
    </script>

    <style>
        /* ── hero ────────────────────────────────────────────────────── */
        .atelier-hero {
            padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
        }

        .atelier-title {
            margin-top: 0.4rem;
        }

        .atelier-lede {
            max-width: 42ch;
            font-size: clamp(1.05rem, 1.6vw, 1.18rem);
            line-height: 1.6;
            color: var(--color-ink-body);
        }

        .atelier-meta {
            display: inline-flex;
            align-items: center;
            gap: 0.85rem;
            font-family: var(--font-mono);
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--color-ink-muted);
        }

        .atelier-meta .floret {
            width: 0.8rem;
            height: 0.8rem;
            color: var(--color-sage);
        }

        .setup-folio-rule {
            display: flex;
            align-items: center;
            gap: 0.9rem;
            margin-top: clamp(2rem, 5vw, 3rem);
            color: var(--color-green);
        }

        .setup-folio-rule span {
            flex: 1;
            border-top: 3px double var(--color-border-strong);
        }

        .setup-folio-rule svg {
            width: 0.9rem;
            height: 0.9rem;
            flex: none;
        }

        /* ── chapter I · the desk scene ────────────────────────────────
           A composed spread, not a table: blocks sit at different widths
           and heights on a 12-col grid, each ruled off with its own
           kicker. One glance should read "arranged", not "listed". */
        .desk-scene {
            display: grid;
            grid-template-columns: repeat(12, minmax(0, 1fr));
            gap: clamp(1.75rem, 3.5vw, 3rem);
            align-items: start;
        }

        .desk-machine-wrap {
            grid-column: 1 / 8;
        }

        .desk-hands {
            grid-column: 1 / 9;
            margin-top: clamp(0.5rem, 2vw, 1.5rem);
        }

        .desk-ears {
            grid-column: 9 / 13;
            margin-top: clamp(3.5rem, 8vw, 7rem);
        }

        .desk-power {
            grid-column: 10 / 13;
            align-self: center;
        }

        .desk-stash {
            grid-column: 2 / 12;
        }

        .desk-block {
            position: relative;
            padding-top: 1rem;
            border-top: 1px solid var(--color-border);
        }

        .desk-machine {
            border-top: 3px double var(--color-border-strong);
            padding-top: 1.35rem;
        }

        .desk-kicker,
        .desk-sub,
        .filmstrip-label,
        .repo-kicker,
        .sheet-kicker {
            margin: 0 0 0.9rem;
            font-family: var(--font-sans);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.24em;
            text-transform: uppercase;
            color: var(--color-green-deep);
        }

        .desk-sub {
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
            color: var(--color-ink-muted);
        }

        .desk-feature-name {
            margin: 0;
            font-family: var(--font-display);
            font-style: italic;
            font-weight: 500;
            font-size: clamp(1.9rem, 4vw, 2.9rem);
            line-height: 1.08;
            letter-spacing: -0.01em;
            color: var(--color-ink);
        }

        .desk-feature-role {
            margin: 0.55rem 0 0;
            max-width: 34rem;
            font-size: 1rem;
            color: var(--color-ink-body);
        }

        .desk-trio {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
            padding-left: clamp(1rem, 3vw, 2rem);
        }

        .desk-item + .desk-item {
            margin-top: 1.15rem;
        }

        .desk-trio .desk-item + .desk-item {
            margin-top: 0;
        }

        .desk-name {
            margin: 0;
            font-family: var(--font-display);
            font-style: italic;
            font-weight: 500;
            font-size: clamp(1.05rem, 1.7vw, 1.3rem);
            line-height: 1.2;
            color: var(--color-ink);
        }

        .desk-role {
            margin: 0.3rem 0 0;
            font-size: 0.88rem;
            line-height: 1.5;
            color: var(--color-ink-muted);
        }

        .desk-stash {
            border-top: 3px double var(--color-border-strong);
        }

        .desk-stash-line {
            margin: 0;
            max-width: 56rem;
            font-family: var(--font-display);
            font-style: italic;
            font-weight: 500;
            font-size: clamp(1.25rem, 2.6vw, 1.9rem);
            line-height: 1.45;
            color: var(--color-ink);
        }

        .desk-stash-end {
            display: block;
            margin-top: 0.6rem;
            font-family: var(--font-sans);
            font-style: normal;
            font-size: 0.95rem;
            color: var(--color-ink-muted);
        }

        @media (max-width: 860px) {
            .desk-scene {
                grid-template-columns: 1fr;
            }

            .desk-machine-wrap,
            .desk-hands,
            .desk-ears,
            .desk-power,
            .desk-stash {
                grid-column: 1 / -1;
                margin-top: 0;
            }
        }

        @media (max-width: 560px) {
            .desk-trio {
                grid-template-columns: 1fr;
                gap: 0.85rem;
                padding-left: 0;
            }
        }

        /* ── chapter II · tools + editor sheet ───────────────────────── */
        .daily-grid {
            display: grid;
            grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
            gap: clamp(2rem, 5vw, 4rem);
            align-items: start;
        }

        .tool-stack {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        /* staggered stack — every other line indents so the column reads
           as arranged type, not a menu */
        .tool-line:nth-child(even) {
            margin-left: clamp(1rem, 4vw, 2.5rem);
        }

        .tool-line + .tool-line {
            margin-top: clamp(1.5rem, 3vw, 2.25rem);
        }

        .tool-link {
            display: inline-flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 0.35rem 0.9rem;
            text-decoration: none;
            color: inherit;
        }

        .tool-name {
            font-family: var(--font-display);
            font-style: italic;
            font-weight: 500;
            font-size: clamp(1.5rem, 3vw, 2.1rem);
            line-height: 1.1;
            color: var(--color-ink);
            transition: color 0.2s var(--ease);
        }

        .tool-role {
            font-size: 0.9rem;
            color: var(--color-ink-muted);
        }

        .tool-link svg {
            width: 0.9rem;
            height: 0.9rem;
            color: var(--color-ink-muted);
            transition:
                color 0.2s var(--ease),
                transform 0.2s var(--ease);
        }

        .tool-link:hover .tool-name,
        .tool-link:focus-visible .tool-name {
            color: var(--color-green-deep);
        }

        .tool-link:hover svg,
        .tool-link:focus-visible svg {
            color: var(--color-lilac-deep);
            transform: translate(2px, -2px);
        }

        /* the pressed specimen sheet — double rule, tint ground */
        .editor-sheet {
            position: relative;
            padding: clamp(1.25rem, 3vw, 1.9rem);
            background: var(--color-surface-tint);
            border: 1px solid var(--color-border-strong);
        }

        .editor-sheet::before {
            content: '';
            position: absolute;
            inset: 5px;
            border: 1px solid var(--color-border);
            pointer-events: none;
        }

        .sheet-kicker {
            position: relative;
            margin-bottom: 0.35rem;
        }

        .sheet-title {
            position: relative;
            margin: 0 0 1.15rem;
            font-family: var(--font-display);
            font-style: italic;
            font-weight: 500;
            font-size: clamp(1.45rem, 2.6vw, 1.95rem);
            line-height: 1.15;
            color: var(--color-ink);
        }

        .sheet-list {
            position: relative;
            margin: 0;
        }

        .sheet-row {
            display: grid;
            grid-template-columns: 7rem minmax(0, 1fr);
            gap: 0.4rem 1.25rem;
            padding: 0.75rem 0;
            border-top: 1px solid var(--color-border);
        }

        .sheet-row dt {
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--color-green-deep);
            padding-top: 0.2rem;
        }

        .sheet-row dd {
            margin: 0;
            font-size: 0.9rem;
            line-height: 1.6;
            color: var(--color-ink-body);
        }

        /* the theme shot — one large frame below the spread; the visible
           variant (and the caption word) follows html[data-theme] */
        .theme-shot {
            margin: clamp(2.75rem, 6vw, 4.5rem) 0 0;
        }

        .theme-shot-frame {
            position: relative;
            padding: 6px;
            border: 1px solid var(--color-border-strong);
            outline: 1px solid var(--color-border);
            outline-offset: -6px;
            background: var(--color-surface);
        }

        .theme-shot-img {
            display: block;
            width: 100%;
            aspect-ratio: 3360 / 1964;
            object-fit: cover;
            object-position: top center;
            background: var(--color-surface-tint);
        }

        .theme-shot-img--main,
        .theme-shot-variant--main {
            display: none;
        }

        html[data-theme='dark'] .theme-shot-img--dawn,
        html[data-theme='dark'] .theme-shot-variant--dawn {
            display: none;
        }

        html[data-theme='dark'] .theme-shot-img--main {
            display: block;
        }

        html[data-theme='dark'] .theme-shot-variant--main {
            display: inline;
        }

        @media (prefers-color-scheme: dark) {
            :root:not([data-theme]) .theme-shot-img--dawn,
            :root:not([data-theme]) .theme-shot-variant--dawn {
                display: none;
            }

            :root:not([data-theme]) .theme-shot-img--main {
                display: block;
            }

            :root:not([data-theme]) .theme-shot-variant--main {
                display: inline;
            }
        }

        .theme-shot-cap {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            justify-content: space-between;
            gap: 0.5rem 1.5rem;
            margin-top: 0.85rem;
        }

        .theme-shot-name {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--color-ink-muted);
        }

        .theme-shot-name em {
            font-style: normal;
            font-weight: 600;
            color: var(--color-green-deep);
        }

        .theme-shot-note {
            font-family: var(--font-display);
            font-style: italic;
            font-size: clamp(1rem, 1.6vw, 1.15rem);
            line-height: 1.4;
            color: var(--color-green);
        }

        @media (max-width: 860px) {
            .daily-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 560px) {
            .sheet-row {
                grid-template-columns: 1fr;
            }
        }

        /* ── chapter III · archive ───────────────────────────────────── */
        .archive-desk {
            margin: 0;
        }

        .archive-desk-frame {
            overflow: hidden;
            border: 1px solid var(--color-border-strong);
            border-radius: 0;
            box-shadow: 0 6px 12px -8px rgb(37 31 22 / 0.2);
            aspect-ratio: 16 / 9;
            position: relative;
        }

        .archive-desk-frame::before {
            content: '';
            position: absolute;
            inset: 4px;
            border: 1px solid var(--color-border);
            pointer-events: none;
            z-index: 1;
        }

        /* oversized inside the mask so the data-drift scrub never shows
           an edge — the photo pans like a window as the chapter passes */
        .archive-desk-img {
            display: block;
            width: 100%;
            height: 122%;
            margin-top: -11%;
            object-fit: cover;
            will-change: transform;
        }

        .setup-archive-caption {
            margin: 0.6rem 0 0;
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--color-ink-muted);
        }

        .filmstrip {
            overflow: hidden;
            margin-top: clamp(1.5rem, 3vw, 2.25rem);
        }

        .filmstrip-label {
            margin-bottom: 0.9rem;
        }

        .filmstrip-track {
            display: flex;
            width: max-content;
            gap: 1rem;
            padding-bottom: 0.5rem;
            will-change: transform;
        }

        .filmstrip-item {
            flex: none;
            display: block;
            width: clamp(13rem, 22vw, 18rem);
            text-decoration: none;
            color: inherit;
        }

        .filmstrip-frame {
            position: relative;
            display: block;
            overflow: hidden;
            border: 1px solid var(--color-border-strong);
            background: var(--color-surface-tint);
            transition:
                border-color 0.25s var(--ease),
                box-shadow 0.25s var(--ease);
        }

        .filmstrip-frame::before {
            content: '';
            position: absolute;
            inset: 4px;
            border: 1px solid var(--color-border);
            pointer-events: none;
            z-index: 1;
        }

        .filmstrip-item:hover .filmstrip-frame,
        .filmstrip-item:focus-visible .filmstrip-frame {
            border-color: var(--color-green);
            box-shadow: 0 4px 16px -8px rgb(37 31 22 / 0.18);
        }

        .filmstrip-frame img {
            display: block;
            width: 100%;
            aspect-ratio: 16 / 9;
            object-fit: cover;
            transition: transform 0.35s var(--ease);
        }

        .filmstrip-item:hover img {
            transform: scale(1.03);
        }

        .filmstrip-cap {
            display: block;
            padding-top: 0.5rem;
            font-family: var(--font-mono);
            font-size: 0.625rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--color-ink-muted);
        }

        /* native horizontal scroll on touch — the scrub owns desktop */
        @media (max-width: 767px) {
            .filmstrip {
                overflow-x: auto;
                scroll-snap-type: x proximity;
                -webkit-overflow-scrolling: touch;
            }

            .filmstrip-track {
                transform: none !important;
            }

            .filmstrip-item {
                scroll-snap-align: start;
                width: min(70vw, 16rem);
            }
        }

        /* ── repo tickets ────────────────────────────────────────────── */
        .repo-block {
            padding-top: clamp(1.5rem, 3vw, 2.25rem);
            border-top: 1px solid var(--color-border);
        }

        .repo-kicker {
            margin-bottom: 1rem;
        }

        .repo-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        /* chamfered ticket — cut corners, double rule, ring on hover */
        .repo-ticket {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.7rem 1.15rem;
            background: var(--color-surface);
            border: 1px solid var(--color-border-strong);
            clip-path: polygon(
                8px 0,
                100% 0,
                100% calc(100% - 8px),
                calc(100% - 8px) 100%,
                0 100%,
                0 8px
            );
            text-decoration: none;
            color: var(--color-ink);
            transition:
                background 0.2s var(--ease),
                box-shadow 0.2s var(--ease),
                color 0.2s var(--ease);
        }

        .repo-ticket::after {
            content: '';
            position: absolute;
            inset: 3px;
            border: 1px solid color-mix(in oklab, var(--color-border) 70%, transparent);
            pointer-events: none;
            clip-path: polygon(
                7px 0,
                100% 0,
                100% calc(100% - 7px),
                calc(100% - 7px) 100%,
                0 100%,
                0 7px
            );
        }

        .repo-ticket:hover,
        .repo-ticket:focus-visible {
            background: color-mix(in oklab, var(--color-lilac) 14%, var(--color-surface));
            box-shadow: 0 0 0 2px color-mix(in oklab, var(--color-lilac) 55%, transparent);
            color: var(--color-ink);
        }

        .repo-ticket svg {
            width: 1rem;
            height: 1rem;
            color: var(--color-ink-muted);
            transition: color 0.2s var(--ease);
        }

        .repo-ticket:hover svg,
        .repo-ticket:focus-visible svg {
            color: var(--color-lilac-deep);
        }

        .repo-ticket-label {
            font-family: var(--font-sans);
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        /* ── archive gallery dialog ──────────────────────────────────── */
        .setup-gallery {
            margin: auto;
            padding: 0;
            width: min(92vw, 62rem);
            max-height: 92vh;
            background: var(--color-surface);
            color: var(--color-ink);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-lg);
            box-shadow: 0 8px 12px -6px rgb(0 0 0 / 0.5);
        }

        .setup-gallery::backdrop {
            background: rgba(37, 31, 22, 0.55);
        }

        @keyframes setup-gallery-in {
            from {
                opacity: 0;
                transform: translateY(10px) scale(0.985);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .setup-gallery[open] {
            animation: setup-gallery-in 0.28s var(--ease) both;
        }

        .setup-gallery-figure {
            margin: 0;
        }

        .setup-gallery-figure img {
            display: block;
            width: 100%;
            max-height: calc(92vh - 6.4rem);
            object-fit: contain;
            background: var(--color-ink);
        }

        .setup-gallery-caption {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.7rem 1rem;
            border-top: 1px solid var(--color-border);
            font-family: var(--font-mono);
            font-size: 0.6875rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--color-ink-muted);
        }

        .setup-gallery-caption-end {
            display: inline-flex;
            align-items: baseline;
            gap: 0.9rem;
        }

        .setup-gallery-link {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            color: var(--color-green-deep);
            text-decoration: none;
            transition: color 0.18s var(--ease);
        }

        .setup-gallery-link:hover,
        .setup-gallery-link:focus-visible {
            color: var(--color-lilac-deep);
            text-decoration: underline;
        }

        .setup-gallery-link svg {
            width: 0.62rem;
            height: 0.62rem;
        }

        .setup-gallery-close {
            position: absolute;
            top: 0.6rem;
            right: 0.6rem;
            z-index: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2rem;
            height: 2rem;
            padding: 0;
            background: color-mix(in srgb, var(--color-ink) 62%, transparent);
            color: var(--color-ink-on-green);
            border: none;
            border-radius: 999px;
            cursor: pointer;
            transition: background 0.18s var(--ease);
        }

        .setup-gallery-close:hover,
        .setup-gallery-close:focus-visible {
            background: var(--color-ink);
        }

        .setup-gallery-close svg {
            width: 0.95rem;
            height: 0.95rem;
        }

        .setup-gallery-nav {
            display: flex;
            justify-content: space-between;
            gap: 0.6rem;
            padding: 0.7rem 1rem 1rem;
        }

        .setup-gallery-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.6rem;
            height: 2.2rem;
            padding: 0;
            background: var(--color-surface);
            color: var(--color-ink-body);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius);
            cursor: pointer;
            transition:
                color 0.18s var(--ease),
                border-color 0.18s var(--ease),
                background 0.18s var(--ease);
        }

        .setup-gallery-btn:hover,
        .setup-gallery-btn:focus-visible {
            color: var(--color-green-deep);
            border-color: var(--color-green);
            background: var(--color-surface-tint);
        }

        .setup-gallery-btn svg {
            width: 1rem;
            height: 1rem;
        }

        @media (prefers-reduced-motion: reduce) {
            .setup-gallery[open] {
                animation: none;
            }

            .filmstrip-frame img,
            .archive-desk-img {
                transition: none;
                transform: none;
                height: 100%;
                margin-top: 0;
            }
        }
    </style>
</BaseLayout>
