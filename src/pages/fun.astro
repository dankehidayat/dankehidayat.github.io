---
import BaseLayout from '../layouts/BaseLayout.astro';
import FunCard from '../components/FunCard.astro';
import Icon from '../components/Icon.astro';
import ChevronDownIcon from '@hugeicons/core-free-icons/ChevronDownIcon';
import ExternalLinkIcon from '@hugeicons/core-free-icons/ExternalLinkIcon';
import { renderIconSvg } from '../lib/huge-icons';
import { funManga, funAnime, funNovels, musicGroups, musicArtists } from '../data/fun';

const allEntries = [...funManga, ...funAnime, ...funNovels];
const chevronMarkup = renderIconSvg(ChevronDownIcon);
const externalLinkMarkup = renderIconSvg(ExternalLinkIcon);
---

<BaseLayout
    title="Fun"
    description="The leisurely corner of Danke Hidayat's site: yuri manga, anime, light novels, and music."
>
    <div class="content-page site-shell">
        <header class="page-header fun-header">
            <p class="fun-kicker">The leisurely corner</p>
            <h1 class="page-title">Fun</h1>
            <p class="page-lede">
                This page corner is where we stop with all the work life for a while. Just the yuri
                manga, the anime, the light novels, and the songs on repeat. Tap any cover for the
                full detail, and fair warning: I tend to reread and rewatch things a lot.
            </p>
        </header>

        <section class="fun-section" id="manga">
            <div class="fun-heading-row">
                <div>
                    <h2 class="fun-heading">Manga</h2>
                    <p class="fun-intro">
                        The series that made me fall for the genre, and the new ones I can't stop
                        thinking about.
                    </p>
                </div>
                <span class="fun-count">{funManga.length}</span>
            </div>
            <div class="fun-grid">
                {funManga.map((entry) => <FunCard entry={entry} />)}
            </div>
        </section>

        <section class="fun-section" id="anime">
            <div class="fun-heading-row">
                <div>
                    <h2 class="fun-heading">Anime</h2>
                    <p class="fun-intro">
                        Some of these I rewatch yearly. The ones marked with a heart I've probably
                        rewatched more times than I should admit.
                    </p>
                </div>
                <span class="fun-count">{funAnime.length}</span>
            </div>
            <div class="fun-grid">
                {funAnime.map((entry) => <FunCard entry={entry} />)}
            </div>
        </section>

        <section class="fun-section" id="novels">
            <div class="fun-heading-row">
                <div>
                    <h2 class="fun-heading">Light novels</h2>
                    <p class="fun-intro">
                        The books I actually read, as opposed to the ones I keep telling myself I'll
                        get to.
                    </p>
                </div>
                <span class="fun-count">{funNovels.length}</span>
            </div>
            <div class="fun-grid">
                {funNovels.map((entry) => <FunCard entry={entry} />)}
            </div>
        </section>

        <section class="fun-section fun-music" id="music">
            <h2 class="fun-heading">Music</h2>
            <p class="fun-intro">What's on right now and the tracks on repeat.</p>

            <!-- Live now-playing, polled from /api/now-playing every 30s -->
            <div class="now-playing" id="now-playing" hidden>
                <div class="now-playing-card">
                    <img id="now-playing-art" class="now-playing-art" alt="" width="96" height="96" hidden />
                    <div class="now-playing-body">
                        <p class="now-playing-label" id="now-playing-label">
                            <span class="now-playing-dot" id="now-playing-dot" aria-hidden="true"></span>
                            <span id="now-playing-label-text">Listening now</span>
                        </p>
                        <p class="now-playing-track" id="now-playing-track" aria-live="polite"></p>
                        <p class="now-playing-artist" id="now-playing-artist"></p>
                        <p class="now-playing-album" id="now-playing-album" hidden></p>
                    </div>
                    <a class="now-playing-link" id="now-playing-link" href="#" target="_blank" rel="noopener">
                        <span>on last.fm</span>
                        <Icon name="external" aria-hidden="true" />
                    </a>
                </div>
                <p class="now-playing-refresh">Refreshes every 30 seconds</p>
            </div>

            <!-- Favourite groups: flat on desktop, accordion on mobile -->
            <h3 class="fun-subheading">On repeat</h3>
            <div class="fun-music-accordion" id="fun-music">
                {musicGroups.map((group, gi) => (
                    <details class="fun-group-card" open data-accent={gi % 2}>
                        <summary class="fun-group-header">
                            <span class="fun-group-id" aria-hidden="true">{group.artist.slice(0, 2)}</span>
                            <span class="fun-group-heading">
                                <span class="fun-group-header-name">{group.artist}</span>
                                <span class="fun-group-header-meta">
                                    <span class="fun-group-header-count">{group.tracks.length} tracks</span>
                                </span>
                            </span>
                            <svg
                                class="fun-group-header-chevron"
                                viewBox="0 0 24 24"
                                width="16"
                                height="16"
                                fill="none"
                                aria-hidden="true"
                            >
                                <Fragment set:html={chevronMarkup} />
                            </svg>
                        </summary>
                        <div class="fun-group-tracks">
                            {group.tracks.map((track, ti) => (
                                <div class="fun-track-row">
                                    <span class="fun-track-no" aria-hidden="true">{String(ti + 1).padStart(2, '0')}</span>
                                    <div class="fun-track-row-info">
                                        <span class="fun-track-row-name">{track.title}</span>
                                        <span class="fun-track-row-meta">{track.meta}</span>
                                    </div>
                                    <iframe
                                        class="fun-embed"
                                        data-src={`https://open.spotify.com/embed/track/${track.spotifyId}?utm_source=generator&theme=1`}
                                        width="100%"
                                        height="80"
                                        title={`${track.title} on Spotify`}
                                        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                                        loading="lazy"
                                    ></iframe>
                                </div>
                            ))}
                        </div>
                    </details>
                ))}
            </div>

            <h3 class="fun-subheading">Also on rotation</h3>
            <ul class="fun-artists">
                {musicArtists.map((artist) => (
                    <li>
                        {artist.href ? (
                            <a
                                class="fun-artist"
                                href={artist.href}
                                target="_blank"
                                rel="noopener"
                            >
                                {artist.name}
                                <Icon name="external" aria-hidden="true" />
                            </a>
                        ) : (
                            <span class="fun-artist">{artist.name}</span>
                        )}
                    </li>
                ))}
            </ul>

            <p class="fun-music-actions">
                <a class="fun-stats-btn" href="/stats">
                    <span class="fun-stats-btn-mark" aria-hidden="true">LF</span>
                    <span>Listening stats</span>
                    <Icon name="arrow-right" class="fun-stats-btn-arrow" aria-hidden="true" />
                </a>
            </p>
        </section>
    </div>

    <!-- Detail view: one dialog for every entry, populated from the embedded data -->
    <dialog class="fun-dialog" id="fun-dialog" aria-labelledby="fun-dialog-title">
        <div class="fun-dialog-panel">
            <button type="button" class="fun-dialog-close" aria-label="Close details">
                <Icon name="close" />
            </button>
            <div class="fun-dialog-cover">
                <img id="fun-dialog-cover" src="" alt="" width="460" height="690" />
            </div>
            <div class="fun-dialog-body">
                <p class="fun-dialog-badge" id="fun-dialog-badge" hidden>
                    <Icon name="heart-filled" />
                    <span id="fun-dialog-badge-text">Favorite</span>
                </p>
                <h3 class="fun-dialog-title" id="fun-dialog-title"></h3>
                <p class="fun-dialog-english" id="fun-dialog-english" hidden></p>
                <p class="fun-dialog-desc" id="fun-dialog-desc" hidden></p>
                <p class="fun-dialog-creator" id="fun-dialog-creator"></p>
                <p class="fun-dialog-note" id="fun-dialog-note" hidden></p>
                <div class="fun-dialog-links" id="fun-dialog-links"></div>
            </div>
        </div>
    </dialog>

    <script type="application/json" id="fun-data" set:html={JSON.stringify({ entries: allEntries, externalIcon: externalLinkMarkup })}></script>

    <script>
        const raw = JSON.parse(document.getElementById('fun-data').textContent);
        const data = raw.entries;
        const externalIcon = raw.externalIcon;
        const dialog = document.getElementById('fun-dialog') as HTMLDialogElement;
        const bySlug = new Map(data.map((e: any) => [e.slug, e]));

        const cover = document.getElementById('fun-dialog-cover') as HTMLImageElement;
        const title = document.getElementById('fun-dialog-title') as HTMLElement;
        const english = document.getElementById('fun-dialog-english') as HTMLElement;
        const desc = document.getElementById('fun-dialog-desc') as HTMLElement;
        const creator = document.getElementById('fun-dialog-creator') as HTMLElement;
        const note = document.getElementById('fun-dialog-note') as HTMLElement;
        const badge = document.getElementById('fun-dialog-badge') as HTMLElement;
        const badgeText = document.getElementById('fun-dialog-badge-text') as HTMLElement;
        const links = document.getElementById('fun-dialog-links') as HTMLElement;

        let closing = false;

        const openEntry = (slug: string) => {
            if (closing) return;
            const e = bySlug.get(slug);
            if (!e) return;
            cover.src = `/fun/covers/${e.cover ?? e.slug}.jpg`;
            cover.alt = `Cover of ${e.title}`;
            title.textContent = e.title;
            english.textContent = e.english ?? '';
            english.hidden = !e.english;
            desc.textContent = e.description ?? '';
            desc.hidden = !e.description;
            creator.textContent = e.creator;
            note.textContent = e.note ?? '';
            note.hidden = !e.note;
            badge.hidden = !e.badge;
            badgeText.textContent = e.badge === 'all-time' ? 'All-time favorite' : 'Favorite';
            badge.classList.toggle('fun-dialog-badge-all', e.badge === 'all-time');
            links.innerHTML = (e.links ?? [])
                .map(
                    (l: any) =>
                        `<a class="fun-dialog-link" href="${l.href}" target="_blank" rel="noopener">` +
                        `<span>${l.label}</span>` +
                        `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">${externalIcon}</svg>` +
                        `</a>`
                )
                .join('');
            if (!dialog.open) dialog.showModal();
            document.body.style.overflow = 'hidden';
        };

        const close = () => {
            if (!dialog.hasAttribute('open') || closing) return;
            closing = true;
            dialog.classList.add('is-closing');
            let done = false;
            const finish = () => {
                if (done) return;
                done = true;
                dialog.removeEventListener('animationend', handler);
                dialog.classList.remove('is-closing');
                dialog.close();
                document.body.style.overflow = '';
                closing = false;
            };
            const handler = (ev: AnimationEvent) => {
                if (ev.animationName === 'fun-dialog-out') finish();
            };
            dialog.addEventListener('animationend', handler);
            // Fallback so a missing animationend (reduced motion, etc.) never
            // leaves the dialog stuck open and blocks future clicks.
            window.setTimeout(finish, 240);
        };

        // Reset state on ANY close path (ESC, backdrop click, close()) so the
        // next cover click always works.
        dialog.addEventListener('close', () => {
            closing = false;
            dialog.classList.remove('is-closing');
            document.body.style.overflow = '';
        });
        dialog.addEventListener('cancel', (ev) => {
            // Let the native ESC close happen; the close listener resets state.
            dialog.classList.add('is-closing');
        });

        document.querySelectorAll('.fun-grid').forEach((grid) => {
            grid.addEventListener('click', (ev) => {
                const card = (ev.target as HTMLElement).closest('[data-slug]') as HTMLElement | null;
                if (card) openEntry(card.dataset.slug ?? '');
            });
        });

        document.querySelector('.fun-dialog-close')?.addEventListener('click', close);
        dialog.addEventListener('click', (ev) => {
            if (ev.target === dialog) close();
        });


        // ── now playing (last.fm, polled every 30s) ──
        // Fetched from /api/now-playing (an Astro endpoint reading
        // LASTFM_API_KEY / LASTFM_USERNAME from .env server-side). The card
        // refreshes on a 30-second timer instead of only on page load.
        const nowPlaying = document.getElementById('now-playing');
        const POLL_MS = 30000;

        // ── music groups: flat on desktop, exclusive accordion on mobile ──
        const musicAccordion = document.getElementById('fun-music');
        if (musicAccordion) {
            const cards = Array.from(musicAccordion.querySelectorAll('.fun-group-card'));
            const mq = window.matchMedia('(min-width: 720px)');
            const loadEmbeds = (card) => {
                card.querySelectorAll('iframe[data-src]').forEach((f) => {
                    if (!f.getAttribute('src')) f.setAttribute('src', f.dataset.src || '');
                });
            };
            const applyLayout = () => {
                if (mq.matches) {
                    musicAccordion.classList.add('is-flat');
                    cards.forEach((c) => {
                        c.open = true;
                        loadEmbeds(c);
                    });
                } else {
                    musicAccordion.classList.remove('is-flat');
                    cards.forEach((c, i) => {
                        c.open = i === 0;
                    });
                    if (cards[0]) loadEmbeds(cards[0]);
                }
            };
            cards.forEach((card) => {
                card.addEventListener('toggle', () => {
                    if (!card.open) return;
                    loadEmbeds(card);
                    if (!mq.matches) {
                        cards.forEach((other) => {
                            if (other !== card) other.open = false;
                        });
                    }
                });
            });
            if (mq.addEventListener) mq.addEventListener('change', applyLayout);
            applyLayout();
        }

        if (nowPlaying) {
            async function refreshNowPlaying() {
                try {
                    const res = await fetch('/api/now-playing');
                    const data = await res.json();
                    if (!data || !data.ok) return;
                    const art = document.getElementById('now-playing-art') as HTMLImageElement;
                    const label = document.getElementById('now-playing-label-text');
                    const dot = document.getElementById('now-playing-dot');
                    const trackEl = document.getElementById('now-playing-track');
                    const artistEl = document.getElementById('now-playing-artist');
                    const albumEl = document.getElementById('now-playing-album');
                    const link = document.getElementById('now-playing-link') as HTMLAnchorElement;
                    if (data.image && art) {
                        art.src = data.image;
                        art.alt = `${data.album || data.track} cover`;
                        art.hidden = false;
                    }
                    if (label) label.textContent = data.nowPlaying ? 'Listening now' : 'Last played';
                    if (dot) dot.classList.toggle('now-playing-dot-idle', !data.nowPlaying);
                    if (trackEl) trackEl.textContent = data.track ?? '';
                    if (artistEl) artistEl.textContent = data.artist ?? '';
                    if (albumEl) {
                        albumEl.textContent = data.album ?? '';
                        albumEl.hidden = !data.album;
                    }
                    if (link) link.href = data.url || '#';
                    nowPlaying.hidden = false;
                } catch {
                    /* keep the card in its previous state */
                }
            }
            refreshNowPlaying();
            window.setInterval(refreshNowPlaying, POLL_MS);
        }
    </script>
</BaseLayout>

<style>
    .fun-kicker {
        margin-bottom: 0.7rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-tangerine-deep);
    }

    .fun-section {
        margin-top: clamp(2.75rem, 5.5vw, 4.25rem);
        scroll-margin-top: 4rem;
    }

    .fun-heading-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.5rem;
    }

    .fun-heading {
        margin: 0 0 0.4rem;
        font-family: var(--font-display);
        font-size: clamp(1.4rem, 2.6vw, 1.9rem);
        font-weight: 700;
        letter-spacing: -0.015em;
        line-height: 1.15;
        color: var(--color-ink);
    }

    .fun-count {
        flex-shrink: 0;
        margin-top: 0.35rem;
        padding: 0.28rem 0.7rem;
        border: 1px solid var(--color-border-strong);
        border-radius: 999px;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--color-ink-muted);
    }

    .fun-intro {
        margin: 0 0 1.75rem;
        max-width: 46rem;
        color: var(--color-ink-body);
    }

    /* ── grid ─────────────────────────────────────────────── */
    .fun-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
        gap: 1.6rem 1.15rem;
    }

    .fun-subheading {
        margin: 2.5rem 0 0.9rem;
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--color-ink);
    }

    /* ── now playing (last.fm) ────────────────────────────── */
    .now-playing {
        margin-bottom: 0.5rem;
    }

    .now-playing-card {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        max-width: 30rem;
        padding: 1rem 1.25rem;
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: var(--color-surface);
        box-shadow: 0 18px 34px -26px rgb(37 31 22 / 0.5);
    }

    .now-playing-art {
        flex: none;
        width: 4.25rem;
        height: 4.25rem;
        border-radius: 10px;
        object-fit: cover;
        border: 1px solid var(--color-border);
    }

    .now-playing-body {
        min-width: 0;
    }

    .now-playing-label {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin: 0 0 0.25rem;
        font-family: var(--font-mono);
        font-size: 0.66rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-ink-muted);
    }

    .now-playing-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--color-green-bright);
        box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-green-bright) 25%, transparent);
    }

    .now-playing-dot-idle {
        background: var(--color-ink-muted);
        box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-ink-muted) 20%, transparent);
    }

    .now-playing-track {
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--color-ink);
    }

    .now-playing-artist {
        margin: 0.1rem 0 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        color: var(--color-tangerine-deep);
    }

    .now-playing-album {
        margin: 0.05rem 0 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--color-ink-muted);
    }

    .now-playing-refresh {
        margin: 0.6rem 0 0;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.06em;
        color: var(--color-ink-muted);
    }

    .now-playing-link {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--color-ink-muted);
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.2s var(--ease);
    }

    .now-playing-link:hover {
        color: var(--color-green-deep);
    }

    .now-playing-link svg {
        width: 0.85rem;
        height: 0.85rem;
    }

    /* ── music groups: flat on desktop, accordion on mobile ─────────── */
    .fun-music-accordion {
        display: grid;
        gap: 1rem;
        max-width: 38rem;
    }

    @media (min-width: 720px) {
        .fun-music-accordion {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            align-items: start;
            max-width: none;
        }
    }

    .fun-group-card {
        border: 1px solid var(--color-border);
        border-radius: 14px;
        background: var(--color-surface);
        overflow: hidden;
    }

    .fun-group-card summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.85rem;
        padding: 1rem 1.25rem;
        list-style: none;
        cursor: pointer;
    }

    .fun-group-card summary::-webkit-details-marker {
        display: none;
    }

    .fun-group-id {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 10px;
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
    }

    .fun-group-card[data-accent='0'] .fun-group-id {
        background: var(--color-tangerine);
        color: var(--color-ink-on-tangerine);
    }

    .fun-group-card[data-accent='1'] .fun-group-id {
        background: var(--color-green);
        color: var(--color-ink-on-green);
    }

    .fun-group-heading {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.35rem;
    }

    .fun-group-header-name {
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--color-ink);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 100%;
    }

    .fun-group-header-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .fun-group-header-count {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        padding: 0.2rem 0.6rem;
        border: 1px solid var(--color-border-strong);
        border-radius: 999px;
        color: var(--color-ink-muted);
    }

    .fun-group-card[open] .fun-group-header-count {
        border-color: var(--color-tangerine);
        background: var(--color-tangerine);
        color: var(--color-ink-on-tangerine);
    }

    .fun-group-header-chevron {
        flex: none;
        color: var(--color-ink-muted);
        transition: transform 0.25s var(--ease);
    }

    .fun-group-card[open] .fun-group-header-chevron {
        transform: rotate(90deg);
    }

    .fun-group-tracks {
        display: grid;
        gap: 0.85rem;
        padding: 0.1rem 1.25rem 1.25rem;
    }

    .fun-track-row {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.6rem 0.7rem;
        padding: 0.85rem 0.9rem;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        background: var(--color-surface);
    }

    .fun-track-row:first-child {
        border-color: color-mix(in oklab, var(--color-tangerine) 45%, var(--color-border));
        background: color-mix(in oklab, var(--color-tangerine) 4%, var(--color-surface));
    }

    .fun-track-no {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--color-ink-muted);
        padding-top: 0.1rem;
    }

    .fun-track-row-info {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.6rem;
        min-width: 0;
    }

    .fun-track-row-name {
        font-size: 0.95rem;
