---
import ListeningStats from '../components/charts/ListeningStats';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
    title="Listening stats"
    description="Listening stats by Danke Hidayat: total scrobbles, listening hours, top tags, and recent albums."
>
    <div class="content-page site-shell">
        <header class="page-header">
            <h1 class="page-title">Listening stats</h1>
            <p class="page-lede">
                Total scrobbles, the hours I listen, the tags, and the recent albums.
            </p>
        </header>
        <ListeningStats client:load />
    </div>
</BaseLayout>
