---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { setupHardware, setupTools, setupRepos } from '../data/setup';

const ledgers = [
    {
        id: 'setup-hardware-heading',
        title: 'The hardware',
        intro: 'The laptop, the keyboard, the mice, the audio, and the spare switches.',
        items: setupHardware
    },
    {
        id: 'setup-tools-heading',
        title: 'The tools',
        intro: 'Nothing special, and that\u2019s the point — everything here gets out of the way.',
        items: setupTools
    }
];
let runningIndex = 0;

/** Archive footage for the Previously section — real screenshots, dated as given. */
const archiveShots = [
    {
        src: '/setup/archrice-2019.jpg',
        label: '2019 — Archrice',
        alt: 'Arch Linux desktop rice from 2019, from the Archrice repository',
        width: 1366,
        height: 768,
        repo: { label: 'Archrice repo', href: 'https://github.com/nishimi-ya/Archrice' }
    },
    {
        src: '/setup/rice-flashbang.jpg',
        label: 'BSPWM — the flashbang',
        alt: 'Bright, high-contrast BSPWM desktop from the 2019–2022 ricing era',
        width: 1920,
        height: 1080,
        repo: { label: 'BSPWM dotfiles', href: 'https://github.com/nishimi-ya/dotfiles' }
    },
    {
        src: '/setup/rice-2020.jpg',
        label: 'August 2020',
        alt: 'Linux desktop rice from August 2020',
        width: 1366,
        height: 768
    },
    {
        src: '/setup/rice-misc.jpg',
        label: '2019–2022 era',
        alt: 'Linux desktop rice from the 2019–2022 era',
        width: 1920,
        height: 1080
    },
    {
        src: '/setup/rice-2021.jpg',
        label: 'April 2021',
        alt: 'Linux desktop rice from April 2021',
        width: 1366,
        height: 768
    },
    {
        src: '/setup/rice-2022.jpg',
        label: 'March 2022',
        alt: 'Linux desktop rice from March 2022',
        width: 1920,
        height: 1080
    },
    {
        src: '/setup/openbox-desktop.jpg',
        label: 'Openbox — desktop',
        alt: 'Openbox desktop from the Openbox dotfiles branch',
        width: 1920,
        height: 1080,
        repo: { label: 'Openbox dotfiles', href: 'https://github.com/nishimi-ya/dotfiles/tree/openbox' }
    },
    {
        src: '/setup/openbox-sddm.jpg',
        label: 'Openbox — lockscreen',
        alt: 'SDDM lockscreen from the Openbox dotfiles branch',
        width: 1920,
        height: 1080,
        repo: { label: 'Openbox dotfiles', href: 'https://github.com/nishimi-ya/dotfiles/tree/openbox' }
    }
];
---

<BaseLayout
    title="Setup"
    description="The setup Danke Hidayat works on now — a MacBook Pro M1, the hardware on the desk, and four tools — plus the archived Arch + Hyprland build it replaced."
>
    <div class="content-page site-shell setup">
        <header class="page-header">
            <h1 class="page-title">Setup</h1>
            <p class="page-lede">
                The MacBook Pro I work on, the hardware around it, and the four tools I use
                every day. The Arch + Hyprland setup from two years ago is archived further
                down.
            </p>
        </header>

        <section class="setup-section" aria-labelledby="setup-desk-heading">
            <div class="setup-heading-row">
                <h2 class="setup-heading" id="setup-desk-heading">The desk</h2>
            </div>
            <div class="setup-desk-slot" role="img" aria-label="Photo of the desk, pending">
                <p class="setup-desk-slot-title">Photo pending</p>
                <p class="setup-desk-slot-note">
                    The desk gets photographed someday. When it does, it hangs here — same page,
                    no redesign.
                </p>
            </div>
        </section>

        {
            ledgers.map((ledger) => (
                <section class="setup-section" aria-labelledby={ledger.id}>
                    <div class="setup-heading-row">
                        <div>
                            <h2 class="setup-heading" id={ledger.id}>
                                {ledger.title}
                            </h2>
                            <p class="setup-intro">{ledger.intro}</p>
                        </div>
                        <span class="setup-count">{ledger.items.length} rows</span>
                    </div>

                    <ul class="setup-ledger">
                        {ledger.items.map((item) => {
                            runningIndex += 1;
                            const indexLabel = String(runningIndex).padStart(2, '0');
                            return (
                                <li class="setup-row">
                                    <span class="setup-row-index" aria-hidden="true">
                                        {indexLabel}
                                    </span>
                                    <span class="setup-row-name">{item.name}</span>
                                    <span class="setup-row-role">{item.role}</span>
                                    {item.href ? (
                                        <a
                                            class="setup-row-link"
                                            href={item.href}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            aria-label={`${item.name} — official site`}
                                        >
                                            <Icon name="external" />
                                            <span class="sr-only">opens in a new tab</span>
                                        </a>
                                    ) : (
                                        <span
                                            class="setup-row-link is-empty"
                                            aria-hidden="true"
                                        />
                                    )}
                                </li>
                            );
                        })}
                    </ul>
                </section>
            ))
        }

        <section class="setup-section setup-previously" aria-labelledby="setup-previously-heading">
            <div class="setup-heading-row">
                <h2 class="setup-heading" id="setup-previously-heading">Previously</h2>
            </div>
            <p class="setup-previously-note">
                Two years ago this page would have been a lot longer: Arch, Hyprland, and every
                tool themed to match. That setup is parked now, dotfiles and all.
            </p>
            <div class="setup-repos">
                {
                    setupRepos.map((repo) => (
                        <a
                            class="btn btn-secondary setup-repo"
                            href={repo.href}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <Icon name="github" aria-hidden="true" />
                            {repo.label}
                            <Icon name="external" aria-hidden="true" />
                        </a>
                    ))
                }
            </div>

            <figure class="setup-archive-desk">
                <img
                    src="/setup/desk-2020.jpg"
                    alt="The desk setup in 2020"
                    width="1040"
                    height="585"
                    loading="lazy"
                    decoding="async"
                />
                <figcaption class="setup-archive-caption">The desk in 2020.</figcaption>
            </figure>

            <div class="setup-archive-rice">
                <p class="setup-archive-label">Desktop ricing, 2019–2022.</p>
                <div class="setup-archive-grid">
                    {
                        archiveShots.map((shot, i) => (
                            <a
                                class="setup-archive-thumb"
                                href={shot.src}
                                data-gallery-index={i}
                                data-gallery-label={shot.label}
                                data-gallery-repo={shot.repo?.href}
                                data-gallery-repo-label={shot.repo?.label}
                                aria-label={`${shot.label} — view larger`}
                            >
                                <img
                                    src={shot.src}
                                    alt={shot.alt}
                                    width={shot.width}
                                    height={shot.height}
                                    loading="lazy"
                                    decoding="async"
                                />
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>

        <dialog class="setup-gallery" id="setup-gallery" aria-label="Archive screenshot viewer">
            <button class="setup-gallery-close" id="setup-gallery-close" type="button" aria-label="Close viewer">
                <Icon name="close" aria-hidden="true" />
            </button>
            <figure class="setup-gallery-figure">
                <img id="setup-gallery-img" src="" alt="" />
                <figcaption class="setup-gallery-caption">
                    <span id="setup-gallery-label"></span>
                    <span class="setup-gallery-caption-end">
                        <a
                            class="setup-gallery-link"
                            id="setup-gallery-link"
                            href="#"
                            target="_blank"
                            rel="noopener noreferrer"
                            hidden
                        >
                            <span id="setup-gallery-link-text">dotfiles</span>
                            <Icon name="external" aria-hidden="true" />
                        </a>
                        <span id="setup-gallery-pos"></span>
                    </span>
                </figcaption>
            </figure>
            <div class="setup-gallery-nav">
                <button class="setup-gallery-btn" id="setup-gallery-prev" type="button" aria-label="Previous screenshot">
                    <Icon name="arrow-left" aria-hidden="true" />
                </button>
                <button class="setup-gallery-btn" id="setup-gallery-next" type="button" aria-label="Next screenshot">
                    <Icon name="arrow-right" aria-hidden="true" />
                </button>
            </div>
        </dialog>
    </div>

    <script>
        function bindSetup() {
            const rows = document.querySelectorAll<HTMLElement>('.setup-row');
            rows.forEach((row, i) => {
                row.style.setProperty('--setup-i', String(Math.min(i, 18)));
                row.classList.add('setup-enter');
            });

            // Archive gallery: thumbs open an in-page viewer instead of navigating.
            const dialog = document.getElementById('setup-gallery') as HTMLDialogElement | null;
            const thumbs = Array.from(
                document.querySelectorAll<HTMLAnchorElement>('.setup-archive-thumb')
            );
            if (!dialog || thumbs.length === 0) return;

            const img = document.getElementById('setup-gallery-img') as HTMLImageElement;
            const label = document.getElementById('setup-gallery-label') as HTMLElement;
            const pos = document.getElementById('setup-gallery-pos') as HTMLElement;
            const link = document.getElementById('setup-gallery-link') as HTMLAnchorElement;
            const linkText = document.getElementById('setup-gallery-link-text') as HTMLElement;
            const shots = thumbs.map((a) => ({
                src: a.href,
                label: a.dataset.galleryLabel ?? '',
                alt: a.querySelector('img')?.alt ?? '',
                repo: a.dataset.galleryRepo
                    ? { href: a.dataset.galleryRepo, label: a.dataset.galleryRepoLabel ?? 'dotfiles' }
                    : null
            }));
            let current = 0;

            const render = () => {
                const shot = shots[current];
                img.src = shot.src;
                img.alt = shot.alt;
                label.textContent = shot.label;
                pos.textContent = `${current + 1} / ${shots.length}`;
                if (shot.repo) {
                    link.href = shot.repo.href;
                    linkText.textContent = shot.repo.label;
                    link.hidden = false;
                } else {
                    link.hidden = true;
                }
            };

            thumbs.forEach((a, i) => {
                a.addEventListener('click', (e) => {
                    e.preventDefault();
                    current = i;
                    render();
                    dialog.showModal();
                });
            });

            document.getElementById('setup-gallery-prev')?.addEventListener('click', () => {
                current = (current - 1 + shots.length) % shots.length;
                render();
            });
            document.getElementById('setup-gallery-next')?.addEventListener('click', () => {
                current = (current + 1) % shots.length;
                render();
            });
            document.getElementById('setup-gallery-close')?.addEventListener('click', () => {
                dialog.close();
            });

            // Clicking the dialog chrome (outside the figure) closes it.
            dialog.addEventListener('click', (e) => {
                if (e.target === dialog) dialog.close();
            });

            dialog.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    current = (current - 1 + shots.length) % shots.length;
                    render();
                } else if (e.key === 'ArrowRight') {
                    e.preventDefault();
                    current = (current + 1) % shots.length;
                    render();
                }
            });
        }
        // astro:page-load fires on the initial load and after every view-transition navigation.
        document.addEventListener('astro:page-load', bindSetup);
    </script>

    <style>
        .setup-section {
            margin-bottom: clamp(2.8rem, 6vw, 4rem);
        }

        .setup-section:last-of-type {
            margin-bottom: 0;
        }

        .setup-heading-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem 2rem;
            flex-wrap: wrap;
            margin-bottom: 1.4rem;
        }

        .setup-heading {
            margin: 0;
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.015em;
            color: var(--color-ink);
        }

        .setup-intro {
            margin: 0.5rem 0 0;
            max-width: 38rem;
            color: var(--color-ink-body);
        }

        .setup-count {
            font-family: var(--font-mono);
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--color-ink-muted);
            padding-top: 0.5rem;
        }

        /* ── Desk: the reserved photo slot ───────────────────────────── */
        .setup-desk-slot {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            min-height: 14rem;
            padding: 2rem;
            text-align: center;
            background: var(--color-surface-tint);
            border: 1px dashed var(--color-border-strong);
            border-radius: var(--radius-lg);
        }

        .setup-desk-slot-title {
            margin: 0;
            font-family: var(--font-mono);
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--color-green-deep);
        }

        .setup-desk-slot-note {
            margin: 0;
            max-width: 26rem;
            font-size: 0.95rem;
            color: var(--color-ink-muted);
        }

        /* ── Ledger ───────────────────────────────────────────────────── */
        .setup-ledger {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .setup-row {
            display: grid;
            grid-template-columns: 2.4rem minmax(8rem, 14rem) 1fr 2rem;
            align-items: baseline;
            gap: 0.9rem;
            padding: 0.8rem 0.4rem;
            border-bottom: 1px solid var(--color-border);
            transition: background 0.2s var(--ease);
        }

        .setup-row:hover {
            background: color-mix(in srgb, var(--color-surface-tint) 55%, transparent);
        }

        /* Rows slide in from the index column — the shelf's cards settle
           vertically; the ledger reads itself left to right instead. */
        @keyframes setup-row-in {
            from {
                opacity: 0;
                transform: translateX(-8px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .setup-enter {
            animation: setup-row-in 0.45s var(--ease) both;
            animation-delay: min(calc(var(--setup-i, 0) * 24ms), 420ms);
        }

        @media (prefers-reduced-motion: reduce) {
            .setup-enter {
                animation: none;
            }

            .setup-gallery[open] {
                animation: none;
            }
        }

        .setup-row-index {
            font-family: var(--font-mono);
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            color: var(--color-ink-muted);
            transition: color 0.2s var(--ease);
        }

        .setup-row:hover .setup-row-index {
            color: var(--color-green-deep);
        }

        .setup-row-name {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.98rem;
            color: var(--color-ink);
        }

        .setup-row-role {
            font-size: 0.9rem;
            color: var(--color-ink-body);
        }

        .setup-row-link {
            display: inline-flex;
            align-items: center;
            justify-content: flex-end;
            color: var(--color-ink-muted);
            transition: color 0.2s var(--ease), transform 0.2s var(--ease);
        }

        .setup-row-link:hover {
            color: var(--color-tangerine-deep);
            transform: translateY(-1px);
        }

        .setup-row-link.is-empty {
            visibility: hidden;
        }

        .setup-row-link svg {
            width: 0.95rem;
            height: 0.95rem;
        }

        /* ── Previously ───────────────────────────────────────────────── */
        .setup-previously {
            padding-top: clamp(2rem, 5vw, 2.8rem);
            border-top: 2px solid var(--color-ink);
        }

        .setup-previously-note {
            margin: 0 0 1.3rem;
            max-width: 40rem;
            color: var(--color-ink-body);
        }

        .setup-repos {
            display: flex;
            flex-wrap: wrap;
            gap: 0.6rem;
        }

        .setup-repo svg {
            width: 1rem;
            height: 1rem;
        }

        /* ── Previously: the archive shelf ─────────────────────────────── */
        .setup-archive-desk {
            margin: 1.8rem 0 0;
        }

        .setup-archive-desk img {
            display: block;
            width: 100%;
            height: auto;
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius);
        }

        .setup-archive-caption,
        .setup-archive-label {
            margin: 0.55rem 0 0;
            font-family: var(--font-mono);
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--color-ink-muted);
        }

        .setup-archive-rice {
            margin-top: 2.2rem;
        }

        .setup-archive-label {
            margin: 0 0 0.8rem;
        }

        .setup-archive-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.8rem;
        }

        .setup-archive-thumb {
            display: block;
            overflow: hidden;
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius);
            transition: border-color 0.2s var(--ease);
        }

        .setup-archive-thumb:hover,
        .setup-archive-thumb:focus-visible {
            border-color: var(--color-green);
        }

        .setup-archive-thumb img {
            display: block;
            width: 100%;
            aspect-ratio: 16 / 9;
            object-fit: cover;
            transition: transform 0.3s var(--ease);
        }

        .setup-archive-thumb:hover img {
            transform: scale(1.015);
        }

        /* ── Archive gallery dialog ────────────────────────────────────── */
        .setup-gallery {
            margin: auto;
            padding: 0;
            width: min(92vw, 62rem);
            max-height: 92vh;
            background: var(--color-surface);
            color: var(--color-ink);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
        }

        .setup-gallery::backdrop {
            background: rgba(37, 31, 22, 0.55);
        }

        @keyframes setup-gallery-in {
            from {
                opacity: 0;
                transform: translateY(10px) scale(0.985);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .setup-gallery[open] {
            animation: setup-gallery-in 0.28s var(--ease) both;
        }

        .setup-gallery-figure {
            margin: 0;
        }

        .setup-gallery-figure img {
            display: block;
            width: 100%;
            max-height: calc(92vh - 6.4rem);
            object-fit: contain;
            background: var(--color-ink);
        }

        .setup-gallery-caption {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.7rem 1rem;
            border-top: 1px solid var(--color-border);
            font-family: var(--font-mono);
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--color-ink-muted);
        }

        .setup-gallery-caption-end {
            display: inline-flex;
            align-items: baseline;
            gap: 0.9rem;
        }

        .setup-gallery-link {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            color: var(--color-green-deep);
            text-decoration: none;
            transition: color 0.18s var(--ease);
        }

        .setup-gallery-link:hover,
        .setup-gallery-link:focus-visible {
            color: var(--color-tangerine-deep);
            text-decoration: underline;
        }

        .setup-gallery-link svg {
            width: 0.62rem;
            height: 0.62rem;
        }

        .setup-gallery-close {
            position: absolute;
            top: 0.6rem;
            right: 0.6rem;
            z-index: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2rem;
            height: 2rem;
            padding: 0;
            background: color-mix(in srgb, var(--color-ink) 62%, transparent);
            color: var(--color-ink-on-green);
            border: none;
            border-radius: 999px;
            cursor: pointer;
            transition: background 0.18s var(--ease);
        }

        .setup-gallery-close:hover,
        .setup-gallery-close:focus-visible {
            background: var(--color-ink);
        }

        .setup-gallery-close svg {
            width: 0.95rem;
            height: 0.95rem;
        }

        .setup-gallery-nav {
            display: flex;
            justify-content: space-between;
            gap: 0.6rem;
            padding: 0.7rem 1rem 1rem;
        }

        .setup-gallery-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.6rem;
            height: 2.2rem;
            padding: 0;
            background: var(--color-surface);
            color: var(--color-ink-body);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius);
            cursor: pointer;
            transition: color 0.18s var(--ease), border-color 0.18s var(--ease),
                background 0.18s var(--ease);
        }

        .setup-gallery-btn:hover,
        .setup-gallery-btn:focus-visible {
            color: var(--color-green-deep);
            border-color: var(--color-green);
            background: var(--color-surface-tint);
        }

        .setup-gallery-btn svg {
            width: 1rem;
            height: 1rem;
        }

        @media (max-width: 560px) {
            .setup-row {
                grid-template-columns: 1.8rem 1fr 1.6rem;
                grid-template-areas:
                    'index name link'
                    '. role link';
                row-gap: 0.2rem;
            }

            .setup-row-index {
                grid-area: index;
            }

            .setup-row-name {
                grid-area: name;
            }

            .setup-row-role {
                grid-area: role;
            }

            .setup-row-link {
                grid-area: link;
                align-self: center;
            }

            .setup-archive-grid {
                grid-template-columns: minmax(0, 1fr);
            }
        }
    </style>
</BaseLayout>
