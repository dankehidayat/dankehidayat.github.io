---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import Pagination from '../../../components/Pagination.astro';
import PostCard from '../../../components/PostCard.astro';
import Subscribe from '../../../components/Subscribe.astro';
import siteConfig from '../../../data/site-config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { sortItemsByDateDesc } from '../../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
    return paginate(posts, { pageSize: siteConfig.postsPerPage || 8 });
}

type Props = { page: Page<CollectionEntry<'blog'>> };
const { page } = Astro.props;
const lang = 'id' as const;
const t = useTranslations(lang);
---

<BaseLayout title={t('blog.title')} description={t('blog.lede')} lang={lang}>
    <header class="page-header" data-reveal>
        <p class="label-kicker">{t('blog.title')}</p>
        <h1 class="display-lg" style="margin:0.65rem 0 0">{t('blog.title')}</h1>
        <p class="page-lede">{t('blog.lede')}</p>
    </header>
    <div class="writing-wall" data-reveal>
        {page.data.map((post) => <PostCard post={post} lang={lang} headingLevel="h2" />)}
    </div>
    <Pagination page={page} lang={lang} class="my-14 md:my-16" />
    <Subscribe lang={lang} class="my-8" />
</BaseLayout>
