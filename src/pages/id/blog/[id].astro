---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Button from '../../../components/Button.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import PostCard from '../../../components/PostCard.astro';
import Subscribe from '../../../components/Subscribe.astro';
import siteConfig from '../../../data/site-config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localePath, useTranslations } from '../../../i18n/utils';
import { sortItemsByDateDesc } from '../../../utils/data-utils';
import { slugify } from '../../../utils/common-utils';

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
    const postCount = posts.length;
    return posts.map((post, index) => ({
        params: { id: post.id },
        props: {
            post,
            prevPost: index + 1 !== postCount ? posts[index + 1] : null,
            nextPost: index !== 0 ? posts[index - 1] : null
        }
    }));
}

type Props = {
    post: CollectionEntry<'blog'>;
    prevPost: CollectionEntry<'blog'> | null;
    nextPost: CollectionEntry<'blog'> | null;
};

const { post, prevPost, nextPost } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags = [], seo } = post.data;
const { Content } = await render(post);
const lang = 'id' as const;
const t = useTranslations(lang);
const baseUrl = siteConfig.website || Astro.url.origin;
const href = baseUrl + Astro.url.pathname;
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? excerpt} image={seo?.image} pageType="article" lang={lang}>
    <article class="content-page reading-column">
        <header class="page-header" data-reveal>
            <div class="post-meta" style="margin-bottom:0.75rem">
                <FormattedDate date={publishDate} lang={lang} />
                {
                    updatedDate && (
                        <span>
                            · {t('blog.updated')} <FormattedDate date={updatedDate} lang={lang} />
                        </span>
                    )
                }
            </div>
            <h1 class="display-lg" style="margin:0">{title}</h1>
            {excerpt && <p class="page-lede" style="margin-top:0.85rem">{excerpt}</p>}
        </header>
        <div class="prose prose-lg prose-blog max-w-none" data-reveal>
            <Content />
        </div>
        <script>
            import '../../../scripts/code-blocks.ts';
        </script>
        <div class="post-footer" data-reveal>
            {
                tags.length > 0 && (
                    <div class="tag-row">
                        {tags.map((tag) => (
                            <a href={localePath(lang, `/tags/${slugify(tag)}`)}>#{tag}</a>
                        ))}
                    </div>
                )
            }
            <Button class="copy-url-button" aria-label={t('blog.copyLink')} data-url={href} variant="secondary">
                {t('blog.share')}
            </Button>
        </div>
    </article>

    {
        (prevPost || nextPost) && (
            <section class="reading-column" style="margin:3rem auto">
                <h2 class="display-md" style="margin-bottom:1rem" data-reveal>
                    {t('blog.readNext')}
                </h2>
                <div class="writing-wall" data-reveal>
                    {nextPost && <PostCard post={nextPost} lang={lang} />}
                    {prevPost && <PostCard post={prevPost} lang={lang} />}
                </div>
            </section>
        )
    }

    <div class="reading-column">
        <Subscribe lang={lang} class="my-10" />
    </div>
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const copyUrlButton = document.querySelector('.copy-url-button') as HTMLButtonElement | null;
        copyUrlButton?.addEventListener('click', async () => {
            const url = copyUrlButton.getAttribute('data-url') || '';
            const label = copyUrlButton.innerText;
            await navigator.clipboard.writeText(url);
            copyUrlButton.innerText = 'Tersalin';
            setTimeout(() => {
                copyUrlButton.innerText = label;
            }, 2500);
        });
    });
</script>
