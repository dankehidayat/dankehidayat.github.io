---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localePath, useTranslations } from '../../../i18n/utils';
import { getAllTags, sortItemsByDateDesc } from '../../../utils/data-utils';

const lang = 'id' as const;
const t = useTranslations(lang);
const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
const tags = getAllTags(posts);
---

<BaseLayout title={t('tags.title')} description={t('tags.lede')} lang={lang}>
    <header class="page-header" data-reveal>
        <p class="eyebrow">{t('tags.title')}</p>
        <h1 class="display-lg" style="margin:0.4rem 0 0.6rem">{t('tags.title')}</h1>
        <p class="page-lede">{t('tags.lede')}</p>
    </header>
    <ul class="tag-cloud" data-reveal>
        {
            tags.map((tag) => (
                <li>
                    <a href={localePath(lang, `/tags/${tag.id}`)} class="tag-pill">
                        #{tag.name}
                    </a>
                </li>
            ))
        }
    </ul>
</BaseLayout>
