---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import Pagination from '../../components/Pagination.astro';
import StationCard from '../../components/StationCard.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
    return paginate(projects, { pageSize: siteConfig.projectsPerPage || 8 });
}

type Props = { page: Page<CollectionEntry<'projects'>> };
const { page } = Astro.props;
const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout title={t('projects.title')} description={t('projects.lede')} lang={lang}>
    <header class="page-header" data-reveal>
        <p class="label-kicker">{t('projects.title')}</p>
        <h1 class="display-lg" style="margin:0.65rem 0 0">{t('projects.title')}</h1>
        <p class="page-lede">{t('projects.lede')}</p>
    </header>
    <div class="work-grid">
        {page.data.map((project, index) => <StationCard project={project} lang={lang} index={index} headingLevel="h2" />)}
    </div>
    <Pagination page={page} lang={lang} class="my-16 md:my-20" />
</BaseLayout>
